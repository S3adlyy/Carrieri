<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!-- postuler-popup.fxml -->
<VBox spacing="20" styleClass="postuler-card"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.PostulerPopupController"
      prefWidth="650" prefHeight="720">

    <padding><Insets top="25" right="35" bottom="35" left="35"/></padding>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="10">
        <StackPane prefWidth="80" prefHeight="80" styleClass="postuler-icon-circle">
            <Label text="📨" style="-fx-font-size: 48; -fx-text-fill: white;"/>
        </StackPane>

        <Label text="Postuler à cette offre" styleClass="postuler-title"/>
        <Label fx:id="lblOfferTitle" text="Offre: [Titre]" styleClass="postuler-subtitle"/>
    </VBox>

    <!-- Form fields -->
    <VBox spacing="18">

        <!-- Numéro de téléphone -->
        <VBox spacing="8">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Numéro de téléphone" styleClass="field-label"/>
                <Label text="Pour SMS de confirmation" styleClass="badge-optional"/>
            </HBox>
            <TextField fx:id="txtPhone" promptText="+33 6 12 34 56 78" styleClass="elegant-field"/>
            <Label fx:id="lblPhoneError" text="" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
            <Label text="Format international recommandé (ex: +33612345678)" styleClass="char-counter"/>
        </VBox>

        <!-- Lettre de motivation -->
        <VBox spacing="8">
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Lettre de motivation" styleClass="field-label"/>
                <Label text="Requis" styleClass="badge-required"/>
            </HBox>
            <TextArea fx:id="txtMotivation" promptText="Expliquez pourquoi vous êtes le candidat idéal pour ce poste..."
                      prefRowCount="8" wrapText="true" styleClass="textarea-elegant"/>
            <Label fx:id="lblMotivationError" text="" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="lblCharCount" text="0/1500 | 0 mots" styleClass="char-counter"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Conseils -->
    <VBox spacing="12" styleClass="tips-card">
        <Label text="Conseils pour votre candidature" styleClass="tips-title"/>
        <Label text="- Soyez spécifique sur vos compétences" styleClass="tips-item" wrapText="true"/>
        <Label text="- Mentionnez votre expérience pertinente" styleClass="tips-item" wrapText="true"/>
        <Label text="- Exprimez votre motivation clairement" styleClass="tips-item" wrapText="true"/>
        <Label text="- Relisez avant d'envoyer" styleClass="tips-item" wrapText="true"/>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="Annuler" onAction="#handleCancel" styleClass="btn-reset-elegant" prefWidth="180" prefHeight="50"/>
        <Button text="Envoyer ma candidature" onAction="#handleSubmit" styleClass="btn-publish-elegant" prefWidth="260" prefHeight="52"/>
    </HBox>

</VBox>
