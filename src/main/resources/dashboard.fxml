<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DashboardController"
      spacing="20" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="📊 Tableau de bord"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Année:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="anneeCombo" prefWidth="100"/>
        <Button fx:id="refreshButton" text="🔄 Actualiser"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Indicateur de chargement -->
    <VBox fx:id="loadingIndicator" alignment="CENTER" visible="false">
        <ProgressIndicator/>
        <Label text="Chargement des statistiques..." style="-fx-padding: 10;"/>
    </VBox>

    <!-- Cartes KPI -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
        </columnConstraints>

        <!-- Carte Total Réclamations -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="📋 Total Réclamations" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="totalReclamationsLabel" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Carte Total Feedbacks -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="⭐ Total Feedbacks" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="totalFeedbacksLabel" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Carte Total Traitements -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <Label text="⚡ Total Traitements" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="totalTraitementsLabel" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Carte Moyenne Notes -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="3" GridPane.rowIndex="0">
            <Label text="📊 Note moyenne" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="moyenneNotesLabel" text="0.0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Carte Taux de résolution -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="✅ Taux de résolution" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="tauxResolutionLabel" text="0%"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Carte Temps moyen -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="⏱️ Temps moyen traitement" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
            <Label fx:id="tempsMoyenLabel" text="N/A"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </GridPane>

    <!-- Graphiques sur 2 colonnes -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="34"/>
        </columnConstraints>

        <!-- Graphique Statuts -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="0" GridPane.rowIndex="0">
            <PieChart fx:id="statutChart" title="Par statut" prefHeight="250"/>
        </VBox>

        <!-- Graphique Priorités -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="1" GridPane.rowIndex="0">
            <PieChart fx:id="prioriteChart" title="Par priorité" prefHeight="250"/>
        </VBox>

        <!-- Graphique Feedbacks -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);"
              GridPane.columnIndex="2" GridPane.rowIndex="0">
            <PieChart fx:id="feedbackChart" title="Feedbacks" prefHeight="250"/>
        </VBox>
    </GridPane>

    <!-- Graphique d'évolution -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <BarChart fx:id="evolutionChart" title="Évolution mensuelle" prefHeight="300">
            <xAxis>
                <CategoryAxis fx:id="moisAxis" label="Mois"/>
            </xAxis>
            <yAxis>
                <NumberAxis fx:id="countAxis" label="Nombre"/>
            </yAxis>
        </BarChart>
    </VBox>

    <!-- Réclamations urgentes -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        <Label text="🚨 Réclamations urgentes (non traitées depuis +7 jours)"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
        <ListView fx:id="urgentesListView" prefHeight="150"/>
    </VBox>

</VBox>