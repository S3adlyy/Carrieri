<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.OffresShellController"
            stylesheets="/css/theme-unified.css, /css/theme-dark.css"
            styleClass="shell-root">

    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar-animated"
              prefWidth="70" minWidth="70" maxWidth="70"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <!-- Brand -->
            <VBox styleClass="brand-container" alignment="CENTER">
                <StackPane styleClass="brand-icon">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <Image url="/images/logo.png" />
                    </ImageView>
                </StackPane>
                <Label fx:id="brandText" text="Carrieri" styleClass="brand-text"/>
                <Label fx:id="brandSubtext" text="Gestion des Offres" styleClass="brand-subtext"/>
            </VBox>

            <!-- Navigation buttons (icônes uniquement) -->
            <VBox styleClass="nav-container" alignment="CENTER">
                <Button fx:id="btnAdminDashboard" onAction="#showAdminDashboard" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="👑" styleClass="nav-icon"/>
                            <Label fx:id="adminDashboardText" text="Dashboard Admin" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="btnOffresTable" onAction="#showOffresTable" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="⚙️" styleClass="nav-icon"/>
                            <Label fx:id="offresTableText" text="Gérer les Offres" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="btnOffreAdd" onAction="#showOffreAdd" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="➕" styleClass="nav-icon"/>
                            <Label fx:id="offreAddText" text="Ajouter une Offre" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="btnOffresList" onAction="#showOffresList" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="👁️" styleClass="nav-icon"/>
                            <Label fx:id="offresListText" text="Liste des Offres" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="btnPostulationsCandidats" onAction="#showPostulationsCandidats" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="👤" styleClass="nav-icon"/>
                            <Label fx:id="postulationsCandidatsText" text="Liste des Postulations" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Theme button -->
            <Button fx:id="btnTheme" styleClass="theme-toggle" text="🌙" />

            <!-- User section -->
            <VBox styleClass="user-container" alignment="CENTER">
                <StackPane>
                    <Circle fx:id="navAvatar" radius="20" styleClass="user-avatar-glow"/>
                </StackPane>
                <Label fx:id="navNameLabel" text="Ons Nagara" styleClass="user-name"/>
                <Label text="Admin" styleClass="user-role"/>
                <Button text="🚪" onAction="#logout" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>
</BorderPane>