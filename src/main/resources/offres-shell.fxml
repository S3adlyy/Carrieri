<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.OffresShellController"
      stylesheets="@navbar.css, @app.css"
      prefWidth="1280" prefHeight="900">

    <!-- ========== LEFT SIDEBAR ========== -->
    <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="260" minWidth="260" spacing="0">
        <padding><Insets top="20" right="16" bottom="16" left="16"/></padding>

        <!-- Logo Row -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-row">
            <padding><Insets bottom="30"/></padding>
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                <Image url="@images/logo.png"/>
            </ImageView>
            <Label text="Carrieri" styleClass="logo-text"/>
        </HBox>

        <!-- Nav Buttons -->
        <VBox spacing="4" styleClass="nav-section">
            <padding><Insets top="8"/></padding>

            <!-- Section: Admin -->
            <Label text="ADMIN" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: 700; -fx-padding: 20 0 8 0;"/>

            <Button fx:id="btnAdminDashboard" text="Dashboard Admin" onAction="#showAdminDashboard"
                    styleClass="nav-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="👑" style="-fx-font-size: 16; -fx-text-fill: currentColor;"/>
                </graphic>
            </Button>

            <!-- Section: Recruteur -->
            <Label text="RECRUTEUR" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: 700; -fx-padding: 12 0 8 0;"/>

            <Button fx:id="btnOffresTable" text="Gérer les Offres" onAction="#showOffresTable"
                    styleClass="nav-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="⚙️" style="-fx-font-size: 16; -fx-text-fill: currentColor;"/>
                </graphic>
            </Button>

            <Button fx:id="btnOffreAdd" text="Ajouter une Offre" onAction="#showOffreAdd"
                    styleClass="nav-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="➕" style="-fx-font-size: 16; -fx-text-fill: currentColor;"/>
                </graphic>
            </Button>

            <!-- Section: Candidat -->
            <Label text="CANDIDAT" style="-fx-text-fill: #9ca3af; -fx-font-size: 11; -fx-font-weight: 700; -fx-padding: 20 0 8 0;"/>

            <Button fx:id="btnOffresList" text="Liste des Offres" onAction="#showOffresList"
                    styleClass="nav-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="👁️" style="-fx-font-size: 16; -fx-text-fill: currentColor;"/>
                </graphic>
            </Button>


            <Button fx:id="btnPostulationsCandidats" text="Liste des Postulations" onAction="#showPostulationsCandidats"
                    styleClass="nav-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="👤" style="-fx-font-size: 16; -fx-text-fill: currentColor;"/>
                </graphic>
            </Button>


        </VBox>

        <!-- Spacer pushes user to bottom -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- User Section -->
        <VBox spacing="8" styleClass="user-section">
            <padding><Insets top="16"/></padding>
            <Separator styleClass="nav-separator"/>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="user-row">
                <padding><Insets top="10"/></padding>
                <Circle fx:id="navAvatar" radius="18" styleClass="avatar-circle"/>
                <Label fx:id="navNameLabel" text="Ons Nagara" styleClass="user-name"/>
            </HBox>

            <Button text="Logout" styleClass="nav-btn, logout-btn" maxWidth="Infinity">
                <graphic>
                    <Label text="🚪" style="-fx-font-size: 16; -fx-text-fill: #ef4444;"/>
                </graphic>
            </Button>
        </VBox>
    </VBox>

    <!-- ========== MAIN CONTENT ========== -->
    <StackPane fx:id="contentPane" HBox.hgrow="ALWAYS" styleClass="content-area"/>

</HBox>