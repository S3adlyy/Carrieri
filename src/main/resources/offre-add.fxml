<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane-clean"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.OffreAddController">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="view-root">

        <!-- ==================== HEADER ==================== -->
        <VBox alignment="CENTER" spacing="16" styleClass="header-gradient" prefHeight="240">
            <padding><Insets top="60" bottom="40"/></padding>

            <!-- Sparkle icon with glow -->
            <StackPane prefWidth="100" prefHeight="100" styleClass="header-icon-circle">
                <Label text="✦" style="-fx-font-size: 72; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.7), 16, 0, 0, 0);"/>
            </StackPane>

            <Label text="Ajouter une Offre" styleClass="header-title-big"/>
            <Label text="Remplissez les informations avec soin" styleClass="header-subtitle" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- ==================== FORM CONTENT ==================== -->
        <VBox spacing="40" style="-fx-padding: 40 60 80 60; -fx-background-color: #faf7ff; -fx-background-radius: 32 32 0 0;">

            <!-- Card: Informations principales -->
            <VBox spacing="28" styleClass="form-card">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Informations principales" styleClass="card-title"/>
                    <Label text="Requis" styleClass="badge-required"/>
                </HBox>

                <HBox spacing="24" alignment="TOP_LEFT">
                    <!-- Titre -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Titre de l'offre" styleClass="field-label"/>
                        <TextField fx:id="txtTitre" promptText="Ex: Développeur Full Stack React/Node"
                                   styleClass="input-elegant"/>
                        <Label fx:id="errTitre" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <!-- Type de contrat -->
                    <VBox spacing="10" prefWidth="280">
                        <Label text="Type de contrat" styleClass="field-label"/>
                        <ComboBox fx:id="comboTypeContrat" promptText="CDI, CDD, Stage..."
                                  styleClass="combo-elegant" maxWidth="Infinity"/>
                        <Label fx:id="errTypeContrat" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <!-- Entreprise -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Entreprise" styleClass="field-label"/>
                        <TextField fx:id="txtEntreprise" promptText="Nom de l'entreprise"
                                   styleClass="input-elegant"/>
                        <Label fx:id="errEntreprise" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Card: Description -->
            <VBox spacing="20" styleClass="form-card">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Description détaillée" styleClass="card-title"/>
                    <Label text="Requis" styleClass="badge-required"/>
                </HBox>
                <TextArea fx:id="txtDescription" prefRowCount="8" wrapText="true"
                          promptText="Décrivez le poste, les missions, l'équipe, les technologies utilisées..."
                          styleClass="textarea-elegant"/>
                <Label fx:id="errDescription" styleClass="error-label" managed="false" visible="false"/>
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label fx:id="lblCharCount" text="0/2000" styleClass="char-counter"/>
                </HBox>
            </VBox>

            <!-- Card: Détails du poste -->
            <VBox spacing="28" styleClass="form-card">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Détails du poste" styleClass="card-title"/>
                    <Label text="Requis" styleClass="badge-required"/>
                </HBox>

                <HBox spacing="24">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Salaire mensuel (DT)" styleClass="field-label"/>
                        <TextField fx:id="txtSalaire" promptText="Ex: 2800" styleClass="input-elegant"/>
                        <Label fx:id="errSalaire" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Localisation" styleClass="field-label"/>
                        <TextField fx:id="txtLocalisation" promptText="Ex: Tunis, Ariana, Sfax..."
                                   styleClass="input-elegant"/>
                        <Label fx:id="errLocalisation" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Secteur d'activité" styleClass="field-label"/>
                        <TextField fx:id="txtSecteur" promptText="Ex: IT, Banque, Industrie..."
                                   styleClass="input-elegant"/>
                        <Label fx:id="errSecteur" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>
                </HBox>

                <HBox spacing="24">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Niveau de qualification" styleClass="field-label"/>
                        <ComboBox fx:id="comboQualification" promptText="Bac+3, Bac+5..."
                                  styleClass="combo-elegant" maxWidth="Infinity"/>
                        <Label fx:id="errQualification" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Expérience requise" styleClass="field-label"/>
                        <TextField fx:id="txtExperience" promptText="Ex: 2-4 ans" styleClass="input-elegant"/>
                        <Label fx:id="errExperience" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Compétences clés" styleClass="field-label"/>
                        <TextField fx:id="txtCompetences" promptText="Java, Spring Boot, React, SQL..."
                                   styleClass="input-elegant"/>
                        <Label fx:id="errCompetences" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Card: Contact & Expiration -->
            <VBox spacing="28" styleClass="form-card">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Contact et Validité" styleClass="card-title"/>
                    <Label text="Requis" styleClass="badge-required"/>
                </HBox>

                <HBox spacing="24">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="Contact recruteur (email)" styleClass="field-label"/>
                        <TextField fx:id="txtContact" promptText="recrutement@entreprise.tn"
                                   styleClass="input-elegant"/>
                        <Label fx:id="errContact" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                    <!-- Date d'expiration – modern & aesthetic DateTimePicker -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Date et heure d'expiration" styleClass="field-label"/>
                            <Label text="              Heure et minute (format 24h)" styleClass="field-hint-small"/>
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <!-- Date part -->
                            <DatePicker fx:id="dpExpirationDate" promptText="Date limite"
                                        styleClass="date-picker-elegant" prefWidth="180" prefHeight="52"/>

                            <!-- Time part -->
                            <Spinner fx:id="spExpirationTime" editable="true" prefWidth="140" prefHeight="52">
                                <valueFactory>
                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="23" initialValue="23" amountToStepBy="1"/>
                                </valueFactory>
                            </Spinner>

                            <Label text=":" style="-fx-font-size: 18; -fx-text-fill: #6b7280; -fx-padding: 0 4 0 4;"/>

                            <Spinner fx:id="spExpirationMinute" editable="true" prefWidth="140" prefHeight="52">
                                <valueFactory>
                                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="59" initialValue="59" amountToStepBy="5"/>
                                </valueFactory>
                            </Spinner>
                        </HBox>
                        <Label fx:id="errExpiration" styleClass="error-label" managed="false" visible="false"/>
                    </VBox>

                </HBox>
            </VBox>

            <!-- Aperçu -->
            <!-- <VBox spacing="16" styleClass="preview-card">
                <Label text="Aperçu de l'annonce" styleClass="preview-title"/>
                <Label fx:id="lblPreview" text="L'aperçu de votre offre apparaîtra ici..."
                       wrapText="true" styleClass="preview-content"/>
            </VBox>-->

            <!-- Buttons -->
            <HBox spacing="32" alignment="CENTER" style="-fx-padding: 20 0 40 0;">
                <Button text="Réinitialiser" onAction="#handleReset"
                        styleClass="btn-reset-elegant" prefWidth="180" prefHeight="54"/>
                <Button text="Publier l'offre" onAction="#handleSave"
                        styleClass="btn-publish-elegant" prefWidth="260" prefHeight="58"/>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>