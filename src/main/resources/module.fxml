<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.ModuleController"
      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="📚 Gestion des Modules"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #5E548E;"/>

    <Label fx:id="lblCoursInfo"
           text="Cours ID: 0"
           style="-fx-font-size: 14px; -fx-text-fill: #718096;"/>

    <Separator/>

    <!-- Header avec bouton toggle -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Modules existants" style="-fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnToggleForm" text="➕"
                onAction="#toggleForm"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-size: 16px; -fx-padding: 8 12;"/>
    </HBox>

    <!-- Formulaire (caché au démarrage) -->
    <VBox fx:id="formBox" spacing="10" managed="false" visible="false">
        <Label text="📝 Ajouter un Module" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

        <TextField fx:id="txtTitre" promptText="Titre du module"/>
        <TextArea fx:id="txtDescription" promptText="Description" prefRowCount="2"/>
        <TextField fx:id="txtOrdre" promptText="Ordre (1, 2, 3...)" prefWidth="150"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnAjouter" text="➕ AJOUTER"
                    onAction="#ajouterModule"
                    style="-fx-background-color: #5E548E; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
        </HBox>
        <Separator/>
    </VBox>

    <!-- Liste des modules -->
    <VBox fx:id="tablePane" spacing="10" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableModules" prefHeight="350" VBox.vgrow="ALWAYS" editable="true">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTitre" text="Titre" prefWidth="150" editable="true"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="200" editable="true"/>
                <TableColumn fx:id="colOrdre" text="Ordre" prefWidth="80" editable="true"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="80"/>
            </columns>
        </TableView>

        <!-- Boutons d'actions -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="🤖 GÉNÉRER QUIZ AUTO"
                    onAction="#genererQuizAutomatique"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
            <Button text="📖 Gérer les leçons"
                    onAction="#ajouterLecons"
                    style="-fx-background-color: #9F86C0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
            <Button text="❌ Fermer"
                    onAction="#fermer"
                    style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>

</VBox>