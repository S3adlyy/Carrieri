<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.CandidatShellController"
            stylesheets="/css/theme-unified.css"
            styleClass="shell-root"
            >

    <!-- Left Sidebar avec animations -->
    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar-animated"
              prefWidth="70" minWidth="70" maxWidth="70"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <!-- Brand avec logo -->
            <VBox styleClass="brand-container" alignment="CENTER">
                <StackPane styleClass="brand-icon">
                    <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                        <Image url="/images/logo.png" />
                    </ImageView>
                </StackPane>
                <Label fx:id="brandText" text="Carrieri" styleClass="brand-text"/>
                <Label fx:id="brandSubtext" text="Gestion des Etudes" styleClass="brand-subtext"/>
            </VBox>

            <!-- Navigation avec icônes -->
            <VBox styleClass="nav-container" alignment="CENTER">
                <Button fx:id="btnCatalogue"
                        onAction="#showCatalogue"
                        styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📚" styleClass="nav-icon"/>
                            <Label fx:id="catalogueText" text="Catalogue" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnMesCours"
                        onAction="#showMesCours"
                        styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📖" styleClass="nav-icon"/>
                            <Label fx:id="mesCoursText" text="Mes cours" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnCertificats"
                        onAction="#showCertificats"
                        styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📜" styleClass="nav-icon"/>
                            <Label fx:id="certificatsText" text="Certificats" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="btnRecommandation"
                        onAction="#ouvrirRecommandation"
                        styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="🎯" styleClass="nav-icon"/>
                            <Label text="Recommandations" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnProfil"
                        onAction="#showProfil"
                        styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="👤" styleClass="nav-icon"/>
                            <Label fx:id="profilText" text="Profil" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnTheme" styleClass="theme-toggle" text="🌙"/>
            <Button fx:id="btnChatbot"
                    onAction="#ouvrirChatbot"
                    styleClass="nav-button">
                <graphic>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                            <Image url="/images/logo_chatbot.png" />
                        </ImageView>
                        <Label fx:id="chatbotText" text="Carrieri ChatBot" styleClass="nav-text"/>
                    </HBox>
                </graphic>
            </Button>
            <!-- User section -->
            <!-- User section -->
            <!-- User section -->
            <VBox styleClass="user-container" alignment="CENTER">
                <StackPane>
                    <Circle fx:id="userAvatar" radius="20" styleClass="user-avatar-glow"
                            onMouseClicked="#switchToAdmin"/>
                </StackPane>
                <Label fx:id="userName" text="Bilal El Eter" styleClass="user-name"/>
                <Label fx:id="userRole" text="Candidat" styleClass="user-role"/>
                <Button text="🚪" onAction="#logout" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Content Area -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>