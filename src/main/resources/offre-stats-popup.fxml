<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<!-- offre-stats-popup.fxml - Interface complète avec design cohérent -->
<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane-clean"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.OffreStatsPopupController">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="view-root">

        <!-- ==================== HEADER GRADIENT ==================== -->
        <VBox alignment="CENTER" spacing="16" styleClass="header-gradient" prefHeight="260">
            <padding><Insets top="70" bottom="50"/></padding>

            <!-- Icon circle with glow -->
            <StackPane prefWidth="110" prefHeight="110" styleClass="header-icon-circle">
                <Label text="📊" style="-fx-font-size: 80; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.75), 20, 0, 0, 0);"/>
            </StackPane>

            <Label text="Analytics Avancées" styleClass="header-title-big"/>
            <Label fx:id="lblOffreTitre" text="Statistiques de l'offre"
                   styleClass="header-subtitle" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- ==================== BACK BUTTON + ACTIONS ==================== -->
        <VBox spacing="28" style="-fx-padding: 30 80 10 80; -fx-background-color: #faf7ff;">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <!-- Back Arrow Button -->
                <Button fx:id="btnBack" onAction="#handleBack" styleClass="btn-back-arrow-inline">
                    <graphic>
                        <Label text="←" style="-fx-font-size: 20; -fx-text-fill: #7c3aed;"/>
                    </graphic>
                </Button>
                <Label text="Retour aux offres" style="-fx-text-fill: #6b7280; -fx-font-size: 14; -fx-font-weight: 600;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Info Offre -->
                <VBox spacing="2" alignment="CENTER_RIGHT">
                    <Label fx:id="lblOffreInfo" text="Entreprise • Type • Localisation"
                           style="-fx-text-fill: #6b7280; -fx-font-size: 13; -fx-font-weight: 600;"/>
                </VBox>

                <!-- Export Buttons -->
                <HBox spacing="12">
                    <Button text="📄 PDF" onAction="#handleExportPDF" styleClass="btn-export-pdf"/>
                    <Button text="📊 Excel" onAction="#handleExportExcel" styleClass="btn-export-excel"/>
                </HBox>
            </HBox>
        </VBox>

        <!-- ==================== STATS CONTENT ==================== -->
        <!-- ==================== STATS CONTENT ==================== -->
        <VBox spacing="40" alignment="TOP_CENTER" style="-fx-padding: 40 80 80 80; -fx-background-color: #faf7ff;">

            <!-- KPI Cards Row 1 - Principaux -->
            <HBox spacing="20" alignment="CENTER">

                    <!-- Card 1: Total Vues -->
                    <VBox styleClass="kpi-card" alignment="CENTER" spacing="12"
                          prefWidth="200" prefHeight="140">
                        <Label text="👁️" style="-fx-font-size: 42; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblTotalVues" text="0" styleClass="kpi-value"/>
                        <Label text="Vues Totales" styleClass="kpi-label"/>
                    </VBox>

                    <!-- Card 2: Total Postulations -->
                    <VBox styleClass="kpi-card" alignment="CENTER" spacing="12"
                          prefWidth="200" prefHeight="140">
                        <Label text="📤" style="-fx-font-size: 42; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblTotalPostulations" text="0" styleClass="kpi-value"/>
                        <Label text="Candidatures" styleClass="kpi-label"/>
                    </VBox>

                    <!-- Card 3: Taux Conversion -->
                    <VBox styleClass="kpi-card" alignment="CENTER" spacing="12"
                          prefWidth="200" prefHeight="140">
                        <Label text="🎯" style="-fx-font-size: 42; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblTauxConversion" text="0%" styleClass="kpi-value"/>
                        <Label text="Taux Conversion" styleClass="kpi-label"/>
                    </VBox>

                    <!-- Card 4: Score Qualité -->
                    <VBox styleClass="kpi-card" alignment="CENTER" spacing="12"
                          prefWidth="200" prefHeight="140">
                        <Label text="⭐" style="-fx-font-size: 42; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblScoreQualite" text="0/100" styleClass="kpi-value"/>
                        <Label text="Score Qualité" styleClass="kpi-label"/>
                    </VBox>

                </HBox>

                <!-- KPI Cards Row 2 - Secondaires -->
                <HBox spacing="20" alignment="CENTER">

                    <!-- Card 5: En Attente -->
                    <VBox styleClass="kpi-card-secondary" alignment="CENTER" spacing="8"
                          prefWidth="200" prefHeight="100">
                        <Label text="⏳" style="-fx-font-size: 28; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblEnAttente" text="0" styleClass="kpi-value-small"/>
                        <Label text="En Attente" styleClass="kpi-label-small"/>
                    </VBox>

                    <!-- Card 6: Acceptées -->
                    <VBox styleClass="kpi-card-secondary" alignment="CENTER" spacing="8"
                          prefWidth="200" prefHeight="100">
                        <Label text="✅" style="-fx-font-size: 28; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblAcceptees" text="0" styleClass="kpi-value-small"/>
                        <Label text="Acceptées" styleClass="kpi-label-small"/>
                    </VBox>

                    <!-- Card 7: Taux Acceptation -->
                    <VBox styleClass="kpi-card-secondary" alignment="CENTER" spacing="8"
                          prefWidth="200" prefHeight="100">
                        <Label text="📊" style="-fx-font-size: 28; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblTauxAcceptation" text="0%" styleClass="kpi-value-small"/>
                        <Label text="Taux Acceptation" styleClass="kpi-label-small"/>
                    </VBox>

                    <!-- Card 8: Tendance -->
                    <VBox styleClass="kpi-card-secondary" alignment="CENTER" spacing="8"
                          prefWidth="200" prefHeight="100">
                        <Label text="📈" style="-fx-font-size: 28; -fx-text-fill: #7c3aed;"/>
                        <Label fx:id="lblTendance" text="--" styleClass="kpi-value-small"/>
                        <Label text="Tendance 7j" styleClass="kpi-label-small"/>
                    </VBox>

                </HBox>

                <!-- Séparateur -->
                <Region styleClass="section-separator" prefHeight="2"/>

                <!-- Section Titre : Graphiques -->
                <Label text="📊 Graphiques de Performance" styleClass="section-title-large"
                       style="-fx-padding: 16 0 0 0;"/>

                <!-- Charts Row 1 -->
                <HBox spacing="28" alignment="CENTER">

                    <!-- Line Chart: Évolution des Vues -->
                    <VBox styleClass="chart-card-enhanced" spacing="16" prefWidth="420" prefHeight="340">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📈" style="-fx-font-size: 28;"/>
                            <Label text="Évolution des Vues (30 derniers jours)" styleClass="chart-title-enhanced"/>
                        </HBox>
                        <LineChart fx:id="lineChartVues" legendVisible="false" animated="true"
                                   prefHeight="280" styleClass="stats-line-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Pie Chart: Répartition par statut -->
                    <VBox styleClass="chart-card-enhanced" spacing="16" prefWidth="420" prefHeight="340">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📊" style="-fx-font-size: 28;"/>
                            <Label text="Répartition par Statut" styleClass="chart-title-enhanced"/>
                        </HBox>
                        <PieChart fx:id="pieChartStatuts" legendVisible="false" animated="true"
                                  prefHeight="280" styleClass="stats-pie-chart"/>
                    </VBox>

                </HBox>

                <!-- Charts Row 2 -->
                <HBox spacing="28" alignment="CENTER">

                    <!-- Bar Chart: Vues par Heure -->
                    <VBox styleClass="chart-card-enhanced" spacing="16" prefWidth="420" prefHeight="340">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="⏰" style="-fx-font-size: 28;"/>
                            <Label text="Distribution Horaire des Vues" styleClass="chart-title-enhanced"/>
                        </HBox>
                        <BarChart fx:id="barChartHeures" legendVisible="false" animated="true"
                                  prefHeight="280" styleClass="stats-bar-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Bar Chart: Évolution temporelle -->
                    <VBox styleClass="chart-card-enhanced" spacing="16" prefWidth="420" prefHeight="340">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="📅" style="-fx-font-size: 28;"/>
                            <Label text="Candidatures par Mois" styleClass="chart-title-enhanced"/>
                        </HBox>
                        <BarChart fx:id="barChartEvolution" legendVisible="false" animated="true"
                                  prefHeight="280" styleClass="stats-bar-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM" fx:id="xAxis"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis side="LEFT" fx:id="yAxis"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                </HBox>

                <!-- Salaire Comparison -->
                <VBox styleClass="info-section" spacing="12">
                    <Label text="💰 Analyse Salariale" styleClass="chart-title"/>
                    <Label fx:id="lblSalaireComparaison" text="--" wrapText="true" styleClass="info-text"/>
                </VBox>

                <!-- Séparateur -->
                <Region styleClass="section-separator" prefHeight="2"/>

                <!-- Recommandations -->
                <VBox spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="💡" style="-fx-font-size: 28;"/>
                        <Label text="Recommandations d'Optimisation" styleClass="chart-title"/>
                    </HBox>
                    <VBox fx:id="vboxRecommandations" spacing="12"/>
                </VBox>

                <!-- Séparateur -->
                <Region styleClass="section-separator" prefHeight="2"/>

                <!-- Liste des postulations récentes -->
                <VBox styleClass="recent-list-card" spacing="16">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="🕒" style="-fx-font-size: 28;"/>
                        <Label text="Postulations Récentes (5 dernières)" styleClass="chart-title"/>
                    </HBox>

                    <VBox fx:id="vboxRecentPostulations" spacing="12">
                        <!-- Dynamic content -->
                    </VBox>
                </VBox>

            </VBox>

    </VBox>
</ScrollPane>
