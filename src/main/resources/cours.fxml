<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.CoursController"
           stylesheets="/css/theme-unified.css"
           styleClass="mission-bg"
           prefWidth="1400" prefHeight="900">

    <!-- Background Orbs (bulles) -->
    <Circle radius="250" fill="rgba(94,84,142,0.03)" style="-fx-translate-y: -150; -fx-translate-x: -280;"/>
    <Circle radius="200" fill="rgba(159,134,192,0.02)" style="-fx-translate-y: 200; -fx-translate-x: 250;"/>
    <Circle radius="150" fill="rgba(224,177,203,0.02)" style="-fx-translate-y: -100; -fx-translate-x: 180;"/>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">

        <VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 30;">

            <!-- Header avec icône -->
            <VBox spacing="20" alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                <StackPane style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #231942 0%, #5E548E 100%);
                                 -fx-background-radius: 20;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.3), 25, 0.25, 0, 10);">
                    <Label text="📚" style="-fx-font-size: 36px; -fx-text-fill: white;"/>
                </StackPane>

                <VBox spacing="5" alignment="CENTER">
                    <Label text="Création de Cours"
                           style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #231942; -fx-letter-spacing: -0.5px;"/>
                    <Label text="Définissez les paramètres de votre cours académique"
                           style="-fx-font-size: 15px; -fx-text-fill: #6b7280; -fx-wrap-text: true; -fx-alignment: center;"/>
                </VBox>
            </VBox>

            <!-- FORMULAIRE 3 COLONNES (caché par défaut) - AVEC LE BOUTON À L'INTÉRIEUR -->
            <VBox fx:id="formPane" spacing="25" visible="false" managed="false">

                <!-- Les 3 colonnes en HBox -->
                <HBox spacing="30" alignment="TOP_CENTER">

                    <!-- COLONNE 1: Description du cours -->
                    <VBox spacing="20" styleClass="glass-card" HBox.hgrow="ALWAYS" prefWidth="450">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Description du cours"
                                   style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #231942;"/>
                        </HBox>

                        <TextArea fx:id="txtDescription"
                                  promptText="Décrivez les objectifs du cours, les prérequis, le programme et les compétences acquises..."
                                  wrapText="true"
                                  prefHeight="180"
                                  style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12; -fx-font-size: 14px;"/>

                        <!-- ✅ LABEL D'ERREUR POUR LA DESCRIPTION -->
                        <Label fx:id="errorDescription" text=""
                               style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                               visible="false" managed="false"/>

                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="charCountLabel" text="0/1000"
                                   style="-fx-text-fill: #9ca3af; -fx-font-size: 12px; -fx-font-weight: 600;
                                          -fx-background-color: #f3e8ff; -fx-padding: 4 10; -fx-background-radius: 20;"/>
                        </HBox>
                    </VBox>

                    <!-- COLONNE 2: Titre, Niveau, Durée, Compétences, Conseils -->
                    <VBox spacing="20" styleClass="glass-card" prefWidth="350">

                        <!-- Titre du cours -->
                        <VBox spacing="5">
                            <Label text="Titre du cours *"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>
                            <TextField fx:id="txtTitre" promptText="Ex: JavaFX - Création d'applications"
                                       style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10; -fx-pref-width: 280;"/>
                            <!-- ✅ LABEL D'ERREUR POUR LE TITRE -->
                            <Label fx:id="errorTitre" text=""
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Niveau -->
                        <VBox spacing="5">
                            <Label text="Niveau du cours *"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>
                            <ComboBox fx:id="comboNiveau" promptText="Sélectionner le niveau"
                                      style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 8; -fx-pref-width: 280;"/>
                            <!-- ✅ LABEL D'ERREUR POUR LE NIVEAU -->
                            <Label fx:id="errorNiveau" text=""
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                                   visible="false" managed="false"/>
                            <Label text="Le niveau de difficulté du cours"
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 0 0 0 5;"/>
                        </VBox>

                        <!-- Durée -->
                        <VBox spacing="5">
                            <Label text="Durée (heures) *"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>
                            <TextField fx:id="txtDuree" promptText="Ex: 45"
                                       style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10; -fx-pref-width: 280;"/>
                            <!-- ✅ LABEL D'ERREUR POUR LA DURÉE -->
                            <Label fx:id="errorDuree" text=""
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                                   visible="false" managed="false"/>
                            <Label text="Nombre d'heures total du cours"
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 0 0 0 5;"/>
                        </VBox>

                        <!-- Compétences -->
                        <VBox spacing="5">
                            <Label text="Compétences visées"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>
                            <TextField fx:id="txtCompetences" promptText="Ex: Programmation, Algorithmes, Java"
                                       style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10; -fx-pref-width: 280;"/>
                            <!-- ✅ LABEL D'ERREUR POUR LES COMPÉTENCES -->
                            <Label fx:id="errorCompetences" text=""
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                                   visible="false" managed="false"/>
                        </VBox>

                        <!-- Conseils pour votre cours -->
                        <VBox spacing="12" style="-fx-background-color: #f3e8ff; -fx-background-radius: 16; -fx-padding: 20;">
                            <Label text="📌 Conseils pour votre cours"
                                   style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #5E548E;"/>
                            <VBox spacing="8">
                                <Label text="• Titre clair et explicite (3-200 caract.)" style="-fx-text-fill: #231942; -fx-font-size: 13px;"/>
                                <Label text="• Description détaillée (10-1000 car.)" style="-fx-text-fill: #231942; -fx-font-size: 13px;"/>
                                <Label text="• Niveau adapté au public cible" style="-fx-text-fill: #231942; -fx-font-size: 13px;"/>
                                <Label text="• Durée réaliste (heures totales)" style="-fx-text-fill: #231942; -fx-font-size: 13px;"/>
                                <Label text="• Image de couverture de qualité" style="-fx-text-fill: #231942; -fx-font-size: 13px;"/>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- COLONNE 3: Image et options -->
                    <VBox spacing="20" styleClass="glass-card" prefWidth="320">

                        <!-- Image du cours -->
                        <VBox spacing="5">
                            <Label text="Image du cours *"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button fx:id="btnChoisirImage" text="Choisir une image"
                                        style="-fx-background-color: white; -fx-text-fill: #5E548E; -fx-border-color: #9F86C0; -fx-border-width: 2; -fx-padding: 10 15; -fx-background-radius: 12; -fx-border-radius: 12; -fx-cursor: hand;"/>
                                <Label fx:id="lblImageNom" text="Aucune image"
                                       style="-fx-background-color: #f3e8ff; -fx-text-fill: #5E548E; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 12px;"/>
                            </HBox>

                            <!-- ✅ LABEL D'ERREUR POUR L'IMAGE -->
                            <Label fx:id="errorImage" text=""
                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 2 0 0 5;"
                                   visible="false" managed="false"/>

                            <ImageView fx:id="imageViewForm" fitWidth="200" fitHeight="120" preserveRatio="true"
                                       style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-background-radius: 8;"/>

                            <Label text="Cette image sera la couverture du cours"
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px; -fx-padding: 0 0 0 5;"/>
                        </VBox>

                        <!-- Obligatoire -->
                        <VBox spacing="10">
                            <Label text="Statut du cours"
                                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #231942;"/>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <CheckBox fx:id="chkObligatoire" text="Cours obligatoire"
                                          style="-fx-font-size: 14px;"/>
                                <Label fx:id="lblObligatoire" text="Optionnel"
                                       style="-fx-background-color: #f3e8ff; -fx-text-fill: #5E548E; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- ✅ BOUTON AJOUTER LE COURS (dans le formulaire, en dessous des colonnes) -->
                <HBox spacing="25" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnAjouter" text="AJOUTER LE COURS" onAction="#ajouter"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #231942 0%, #5E548E 100%);
                                   -fx-text-fill: white;
                                   -fx-font-size: 18px;
                                   -fx-font-weight: 900;
                                   -fx-padding: 14 60;
                                   -fx-background-radius: 50;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.4), 20, 0.2, 0, 8);"
                            prefWidth="300"/>
                </HBox>
            </VBox>
            <!-- FIN DU FORMULAIRE -->

            <!-- TABLE PANEL (visible par défaut) -->
            <VBox fx:id="tablePane" spacing="15" visible="true" managed="true"
                  style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 24; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.15), 30, 0.1, 0, 10);">

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Liste des cours" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #231942;"/>
                    <Label fx:id="lblCount" text="0 cours" style="-fx-background-color: #f3e8ff; -fx-text-fill: #5E548E; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 12px;"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Recherche -->
                    <TextField fx:id="txtSearch" promptText="Rechercher un cours..."
                               style="-fx-background-color: white; -fx-border-color: #d8c9f0; -fx-border-radius: 50px; -fx-background-radius: 50px; -fx-padding: 8 20; -fx-pref-width: 250;"/>

                    <!-- Bouton générer test -->
                    <Button text="🤖 GÉNÉRER TEST FINAL"
                            onAction="#genererTestFinalAutomatique"
                            style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"/>

                    <!-- Bouton nouveau cours avec le style dégradé -->
                    <Button text="➕" onAction="#toggleForm"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #231942 0%, #5E548E 100%);
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: 900;
                                   -fx-padding: 8 20;
                                   -fx-background-radius: 50;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.4), 20, 0.2, 0, 8);"
                            prefWidth="100"/>
                </HBox>

                <!-- TABLEAU AVEC TOUTES LES COLONNES -->
                <TableView fx:id="tableCours" VBox.vgrow="ALWAYS" editable="true"
                           style="-fx-background-color: transparent; -fx-border-color: rgba(94,84,142,0.15); -fx-border-radius: 16;">
                    <columns>
                        <TableColumn fx:id="colTitre" text="TITRE" prefWidth="180"/>
                        <TableColumn fx:id="colNiveau" text="NIVEAU" prefWidth="200"/>
                        <TableColumn fx:id="colDuree" text="DURÉE" prefWidth="100"/>
                        <TableColumn fx:id="colDescription" text="DESCRIPTION" prefWidth="250"/>
                        <TableColumn fx:id="colCompetences" text="COMPÉTENCES" prefWidth="200"/>
                        <TableColumn fx:id="colObligatoire" text="STATUT" prefWidth="150"/>
                        <TableColumn fx:id="colImage" text="IMAGE" prefWidth="80"/>
                        <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Status Bar -->
            <HBox alignment="CENTER" style="-fx-background-color: #f8f4ff; -fx-background-radius: 30; -fx-padding: 8 20; -fx-border-color: rgba(94,84,142,0.2); -fx-border-radius: 30; -fx-margin: 10 0 0 0;">
                <Label fx:id="lblStatus" text="✅ Prêt"
                       style="-fx-background-color: #f3e8ff; -fx-text-fill: #5E548E; -fx-padding: 4 12; -fx-background-radius: 20; -fx-font-size: 13px; -fx-font-weight: 600;"/>
            </HBox>

        </VBox>
    </ScrollPane>

</StackPane>