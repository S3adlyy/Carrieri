<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.FeedbackFormController"
      spacing="20" style="-fx-padding: 20;" alignment="TOP_CENTER">

    <Label text="Formulaire de feedback"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <GridPane vgap="15" hgap="10" alignment="CENTER" maxWidth="500">
        <Label text="Commentaire:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextArea fx:id="commentaireArea" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  prefRowCount="4" prefWidth="300" wrapText="true" promptText="Votre commentaire..."/>

        <Label text="Note (0-100):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
            <Slider fx:id="noteSlider" min="0" max="100" value="50"
                    showTickLabels="true" showTickMarks="true" prefWidth="200"/>
            <Label fx:id="noteLabel" text="50" style="-fx-font-weight: bold; -fx-min-width: 30;"/>
        </HBox>

        <Label text="Rendu ID:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="renduIdField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                   prefWidth="300" promptText="ID de la mission"/>

        <Label text="Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"
                    prefWidth="300" promptText="jj/mm/aaaa"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Sauvegarder" onAction="#handleSave"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-padding: 10;"/>
        <Button text="Retour à la liste" onAction="#goBackToList"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-padding: 10;"/>
    </HBox>
</VBox>