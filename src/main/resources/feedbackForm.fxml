<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<DialogPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.FeedbackFormController" prefWidth="500">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <header>
        <Label fx:id="dialogTitle" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
    </header>

    <content>
        <VBox spacing="15">
            <!-- Commentaire -->
            <VBox spacing="5">
                <Label text="Commentaire:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="commentaireArea" promptText="Votre commentaire..."
                          prefRowCount="4" wrapText="true"/>
            </VBox>

            <!-- Note avec Slider -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Note (0-100):" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                <Slider fx:id="noteSlider" min="0" max="100" value="50"
                        showTickLabels="true" showTickMarks="true"
                        majorTickUnit="25" minorTickCount="5"
                        prefWidth="200" HBox.hgrow="ALWAYS"/>
                <Label fx:id="noteLabel" text="50"
                       style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 30;"/>
            </HBox>

            <!-- Rendu ID et Date -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Rendu ID:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                <TextField fx:id="renduIdField" promptText="ID de la mission" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Date:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                <DatePicker fx:id="datePicker" promptText="jj/mm/aaaa" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Boutons -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Sauvegarder" onAction="#handleSave"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-min-width: 100; -fx-padding: 8 15;"/>
                <Button text="Annuler" onAction="#handleCancel"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-min-width: 100; -fx-padding: 8 15;"/>
            </HBox>
        </VBox>
    </content>
</DialogPane>