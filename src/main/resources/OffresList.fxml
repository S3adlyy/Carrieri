<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.OffresListController">

    <Label text="Liste des Offres d'Emploi" />

    <TableView fx:id="tableOffres" prefWidth="800" prefHeight="400">

        <columns>
            <TableColumn fx:id="colTitre" text="Titre" prefWidth="150"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="200"/>
            <TableColumn fx:id="colSalaire" text="Salaire" prefWidth="100"/>
            <TableColumn fx:id="colType" text="Type Contrat" prefWidth="100"/>
            <TableColumn fx:id="colLocalisation" text="Localisation" prefWidth="100"/>
            <TableColumn fx:id="colExpiration" text="Date Expiration" prefWidth="150"/>
        </columns>

    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Ajouter"/>
        <Button text="Modifier"/>
        <Button text="Supprimer"/>
        <Button text="Postuler"/>
    </HBox>

</VBox>
