<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane-clean"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.OffresTableController">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="view-root">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="16" styleClass="header-gradient" prefHeight="220">
            <padding><Insets top="60" bottom="40"/></padding>

            <StackPane prefWidth="90" prefHeight="90" styleClass="header-icon-circle">
                <Label text="📋" style="-fx-font-size: 64; -fx-text-fill: white;"/>
            </StackPane>

            <Label text="Liste des Offres " styleClass="header-title-big"/>
            <Label text="Consultez, Modifiez ou Suuprimez les offres" styleClass="header-subtitle"/>
        </VBox>

        <!-- Search & Controls -->
        <VBox spacing="14" style="-fx-padding: 26 60 12 60;">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch"
                           promptText="Rechercher par titre, entreprise, localisation, secteur, compétences..."
                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
                <Button text="Rafraîchir" onAction="#handleRefresh" styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="lblStatus" text="0 offres trouvées" styleClass="status-text"/>
        </VBox>

        <!-- Table -->
        <VBox style="-fx-padding: 0 60 40 60;">
            <TableView fx:id="tableOffres" editable="true" prefHeight="600" styleClass="styled-table">

                <columns>
                    <!-- DB order -->
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="160"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="220"/>
                    <TableColumn fx:id="colSalaire" text="Salaire" prefWidth="110"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                    <TableColumn fx:id="colLocalisation" text="Localisation" prefWidth="130"/>
                    <TableColumn fx:id="colPublication" text="Publication" prefWidth="120"/>
                    <TableColumn fx:id="colExpiration" text="Expiration" prefWidth="120"/>
                    <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="110"/>
                    <TableColumn fx:id="colExperience" text="Expérience" prefWidth="110"/>
                    <TableColumn fx:id="colCompetences" text="Compétences" prefWidth="200"/>
                    <TableColumn fx:id="colSecteur" text="Secteur" prefWidth="130"/>
                    <TableColumn fx:id="colEntreprise" text="Entreprise" prefWidth="140"/>
                    <TableColumn fx:id="colContact" text="Contact" prefWidth="170"/>

                    <TableColumn fx:id="colActions" text="Actions" prefWidth="170"/>
                </columns>

            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
