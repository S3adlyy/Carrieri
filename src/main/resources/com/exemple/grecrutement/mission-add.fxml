<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.MissionAddController"
           stylesheets="@mission-styles.css"
           styleClass="prf-bg"
           style="-fx-padding: 40;">

    <!-- Subtle Background Elements -->
    <Circle radius="120" fill="rgba(159,134,192,0.03)" style="-fx-translate-y: -180; -fx-translate-x: -320;"/>
    <Circle radius="90" fill="rgba(190,149,196,0.02)" style="-fx-translate-y: 120; -fx-translate-x: 280;"/>

    <!-- Main Container with Better Centering -->
    <VBox alignment="TOP_CENTER" spacing="0" maxWidth="950">

        <!-- Header Section - Clean and Prominent -->
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 0 0 35 0;">
            <!-- Icon Badge with Better Visual Hierarchy -->
            <StackPane style="-fx-background-color: linear-gradient(135deg, #231942 0%, #5E548E 100%);
                             -fx-background-radius: 20;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.3), 25, 0.25, 0, 10);">
                <Label text="📋" style="-fx-font-size: 34px; -fx-text-fill: white;"/>
            </StackPane>

            <!-- Title Section with Better Typography -->
            <VBox spacing="10" alignment="CENTER" maxWidth="700">
                <Label text="Create New Mission"
                       style="-fx-font-size: 36px;
                              -fx-font-weight: 900;
                              -fx-text-fill: #231942;
                              -fx-letter-spacing: -0.8px;
                              -fx-padding: 0 0 5 0;" />

                <Label text="Define mission requirements for candidate evaluation"
                       style="-fx-font-size: 17px;
                              -fx-text-fill: rgba(35,25,66,0.8);
                              -fx-font-weight: 500;
                              -fx-text-alignment: center;
                              -fx-wrap-text: true;
                              -fx-line-spacing: 1.6;" />

                <!-- Subtle Divider -->
                <HBox alignment="CENTER" style="-fx-padding: 18 0 5 0;">
                    <HBox style="-fx-background-color: linear-gradient(to right, transparent 0%, #BE95C4 50%, transparent 100%);
                                -fx-min-height: 2px;
                                -fx-pref-width: 200px;
                                -fx-opacity: 0.4;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Form Card - Improved Spacing and Layout -->
        <VBox styleClass="prf-heroCard"
              style="-fx-padding: 45 60 50 60;
                     -fx-background-radius: 20;
                     -fx-border-radius: 20;
                     -fx-effect: dropshadow(gaussian, rgba(35,25,66,0.14), 40, 0.25, 0, 18);"
              maxWidth="950">

            <!-- Form Grid with Better Column Structure -->
            <GridPane hgap="30" vgap="35" style="-fx-padding: 10 0 0 0;">
                <columnConstraints>
                    <ColumnConstraints prefWidth="200" halignment="RIGHT"/>
                    <ColumnConstraints prefWidth="420"/>
                    <ColumnConstraints prefWidth="230" halignment="LEFT"/>
                </columnConstraints>

                <!-- =========== ROW 1: DESCRIPTION =========== -->
                <VBox alignment="TOP_RIGHT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Mission Description"
                           style="-fx-font-size: 16.5px;
                                  -fx-font-weight: 900;
                                  -fx-text-fill: #231942;
                                  -fx-padding: 10 0 5 0;" />
                    <Label text="Required field"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: rgba(35,25,66,0.55);
                                  -fx-font-weight: 700;
                                  -fx-font-style: italic;" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <TextArea fx:id="descriptionField"
                              promptText="Enter detailed mission description..."
                              styleClass="prf-editorArea"
                              style="-fx-pref-width: 420;
                                     -fx-pref-height: 140;
                                     -fx-wrap-text: true;
                                     -fx-font-size: 14.5px;
                                     -fx-padding: 14 16;" />
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0" alignment="TOP_LEFT">
                    <Label text="Describe what candidates need to accomplish in detail"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: rgba(35,25,66,0.75);
                                  -fx-line-spacing: 1.5;
                                  -fx-wrap-text: true;
                                  -fx-font-weight: 700;" />
                    <Label text="• Include clear objectives
• Specify required deliverables
• Mention evaluation criteria
• Add any constraints or deadlines"
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: rgba(35,25,66,0.6);
                                  -fx-line-spacing: 1.4;
                                  -fx-wrap-text: true;
                                  -fx-padding: 8 0 0 10;" />
                </VBox>

                <!-- =========== ROW 2: MINIMUM SCORE =========== -->
                <VBox alignment="TOP_RIGHT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Minimum Score"
                           style="-fx-font-size: 16.5px;
                                  -fx-font-weight: 900;
                                  -fx-text-fill: #231942;
                                  -fx-padding: 10 0 5 0;" />
                    <Label text="0-100 scale"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: rgba(35,25,66,0.55);
                                  -fx-font-weight: 700;" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <TextField fx:id="scoreField"
                               promptText="Enter minimum score (0-100)"
                               styleClass="prf-editorField"
                               style="-fx-pref-width: 420;
                                      -fx-font-size: 14.5px;
                                      -fx-padding: 14 16;" />
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="1" alignment="TOP_LEFT">
                    <Label text="Required passing score percentage for candidates"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: rgba(35,25,66,0.75);
                                  -fx-line-spacing: 1.5;
                                  -fx-wrap-text: true;
                                  -fx-font-weight: 700;" />
                    <Label text="This is the minimum percentage candidates must achieve to pass the mission evaluation."
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: rgba(35,25,66,0.6);
                                  -fx-line-spacing: 1.4;
                                  -fx-wrap-text: true;
                                  -fx-font-style: italic;" />
                </VBox>

                <!-- =========== ROW 3: CREATOR ID =========== -->
                <VBox alignment="TOP_RIGHT" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Creator ID"
                           style="-fx-font-size: 16.5px;
                                  -fx-font-weight: 900;
                                  -fx-text-fill: #231942;
                                  -fx-padding: 10 0 5 0;" />
                    <Label text="Auto-filled"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: rgba(35,25,66,0.55);
                                  -fx-font-weight: 700;
                                  -fx-font-style: italic;" />
                </VBox>

                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <TextField fx:id="createdByIdField"
                               promptText="Enter your user ID"
                               styleClass="prf-editorField"
                               style="-fx-pref-width: 420;
                                      -fx-font-size: 14.5px;
                                      -fx-padding: 14 16;" />
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="2" alignment="TOP_LEFT">
                    <Label text="Your identification number in the system"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: rgba(35,25,66,0.75);
                                  -fx-line-spacing: 1.5;
                                  -fx-wrap-text: true;
                                  -fx-font-weight: 700;" />
                    <Label text="This ID will be associated with the mission for tracking and reporting purposes."
                           style="-fx-font-size: 13px;
                                  -fx-text-fill: rgba(35,25,66,0.6);
                                  -fx-line-spacing: 1.4;
                                  -fx-wrap-text: true;
                                  -fx-font-style: italic;" />
                </VBox>
            </GridPane>

            <!-- Submit Section - Improved Visual Hierarchy -->
            <VBox spacing="25" alignment="CENTER" style="-fx-padding: 40 0 10 0;">
                <!-- Decorative Line -->
                <HBox alignment="CENTER">
                    <HBox style="-fx-background-color: linear-gradient(to right, transparent, rgba(159,134,192,0.3), transparent);
                                -fx-min-height: 1.5px;
                                -fx-pref-width: 350px;
                                -fx-opacity: 0.5;" />
                </HBox>

                <!-- Primary Action Button -->
                <Button text="🚀 Create Mission"
                        onAction="#ajouterMission"
                        style="-fx-background-color: linear-gradient(135deg, #231942 0%, #5E548E 100%);
                               -fx-text-fill: white;
                               -fx-font-size: 17px;
                               -fx-font-weight: 900;
                               -fx-padding: 18 50;
                               -fx-background-radius: 50;
                               -fx-min-width: 250;
                               -fx-min-height: 60;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.35), 25, 0.25, 0, 10);
                               -fx-letter-spacing: 0.5px;" />

                <!-- Hover effect for button -->
                <style>
                    .button:hover {
                    -fx-background-color: linear-gradient(135deg, #5E548E 0%, #9F86C0 100%);
                    -fx-scale-x: 1.02;
                    -fx-scale-y: 1.02;
                    -fx-effect: dropshadow(gaussian, rgba(159,134,192,0.4), 30, 0.3, 0, 12);
                    }
                    .button:pressed {
                    -fx-scale-x: 0.98;
                    -fx-scale-y: 0.98;
                    -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.25), 20, 0.2, 0, 8);
                    }
                </style>

                <!-- Visual Indicators -->
                <HBox spacing="25" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <Label text="⚡ Fast processing" style="-fx-font-size: 12.5px; -fx-text-fill: rgba(94,84,142,0.7); -fx-font-weight: 700;" />
                    <Label text="•" style="-fx-font-size: 14px; -fx-text-fill: rgba(159,134,192,0.5);" />
                    <Label text="🔒 Secure submission" style="-fx-font-size: 12.5px; -fx-text-fill: rgba(94,84,142,0.7); -fx-font-weight: 700;" />
                    <Label text="•" style="-fx-font-size: 14px; -fx-text-fill: rgba(159,134,192,0.5);" />
                    <Label text="📊 Real-time updates" style="-fx-font-size: 12.5px; -fx-text-fill: rgba(94,84,142,0.7); -fx-font-weight: 700;" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>