<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.ButtonBar?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.MissionAddController"
           stylesheets="@mission-styles.css"
           styleClass="root-container"
           prefWidth="1200" prefHeight="800">

    <!-- Animated Background Orbs -->
    <Circle radius="180" styleClass="bg-orb-1"/>
    <Circle radius="140" styleClass="bg-orb-2"/>
    <Circle radius="100" styleClass="bg-orb-3"/>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="main-scroll">
        <VBox alignment="TOP_CENTER" spacing="0" styleClass="content-wrapper">

            <!-- Header -->
            <VBox spacing="24" alignment="CENTER" styleClass="header-section">

                <!-- Icon with Pulse Animation -->
                <StackPane styleClass="icon-container">
                    <Circle radius="30" styleClass="icon-pulse"/>
                    <Circle radius="26" styleClass="icon-bg"/>
                    <Label text="✦" styleClass="icon-symbol"/>
                </StackPane>

                <!-- Title Group -->
                <VBox spacing="10" alignment="CENTER" maxWidth="680">
                    <Label text="Mission Control"
                           styleClass="main-title"/>

                    <Label text="Définissez les paramètres de votre mission avec précision"
                           styleClass="subtitle"
                           wrapText="true"/>

                    <!-- Decorative Accent Line -->
                    <StackPane styleClass="accent-line-container">
                        <Rectangle styleClass="accent-line"/>
                    </StackPane>
                </VBox>

                <!-- Help Button -->
                <Button text="?"
                        onAction="#showHelp"
                        styleClass="help-button"
                        maxWidth="30">
                    <tooltip>
                        <Tooltip text="Afficher l'aide"/>
                    </tooltip>
                </Button>
            </VBox>

            <!-- Main Form Card -->
            <VBox styleClass="form-card">
                <VBox spacing="32" alignment="TOP_CENTER" maxWidth="1200">

                    <!-- ALL FIELDS IN HORIZONTAL LAYOUT -->
                    <HBox spacing="40" alignment="TOP_CENTER" styleClass="horizontal-form-container">

                        <!-- LEFT COLUMN: Mission Description -->
                        <VBox spacing="12" alignment="TOP_LEFT" styleClass="form-column" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane styleClass="field-icon-wrapper">
                                    <Circle radius="5" styleClass="field-icon-dot"/>
                                </StackPane>
                                <Label text="Mission Description"
                                       styleClass="field-title"/>
                                <Label text="Required"
                                       styleClass="badge-required"/>
                            </HBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <TextArea fx:id="descriptionField"
                                          promptText="Décrivez les objectifs de la mission, les livrables et les critères d'évaluation..."
                                          styleClass="input-area-horizontal"
                                          wrapText="true"
                                          onKeyReleased="#handleDescriptionPaste"
                                          prefHeight="200">
                                    <VBox.margin>
                                        <Insets/>
                                    </VBox.margin>
                                </TextArea>

                                <!-- Character Counter and Error Label -->
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label fx:id="characterCountLabel"
                                           text="0/1000"
                                           styleClass="character-counter"/>
                                    <Label fx:id="descriptionError"
                                           styleClass="error-label"
                                           visible="false"
                                           managed="false"/>
                                </HBox>
                            </VBox>

                            <!-- Tips Panel -->
                            <VBox spacing="12" styleClass="tips-panel-horizontal">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="💡" styleClass="tips-icon"/>
                                    <Label text="Bonnes pratiques" styleClass="tips-title"/>
                                </HBox>

                                <VBox spacing="8">
                                    <Label text="• Soyez spécifique sur les objectifs"
                                           styleClass="tips-item"/>
                                    <Label text="• Définissez des livrables clairs"
                                           styleClass="tips-item"/>
                                    <Label text="• Mentionnez les critères d'évaluation"
                                           styleClass="tips-item"/>
                                    <Label text="• Incluez les contraintes éventuelles"
                                           styleClass="tips-item"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- RIGHT COLUMN: Score and Creator -->
                        <VBox spacing="32" alignment="TOP_LEFT" styleClass="form-column" prefWidth="400">

                            <!-- Minimum Score Section -->
                            <VBox spacing="12" alignment="TOP_LEFT">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="field-icon-wrapper">
                                        <Circle radius="5" styleClass="field-icon-dot"/>
                                    </StackPane>
                                    <Label text="Minimum Passing Score"
                                           styleClass="field-title"/>
                                    <Label text="0-100"
                                           styleClass="badge-info"/>
                                </HBox>

                                <VBox spacing="12">
                                    <!-- Score Input with Error -->
                                    <VBox spacing="8">
                                        <TextField fx:id="scoreField"
                                                   promptText="Entrez le score (ex: 75)"
                                                   styleClass="input-field">
                                            <VBox.margin>
                                                <Insets/>
                                            </VBox.margin>
                                        </TextField>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="Le candidat doit atteindre ce score minimum"
                                                   styleClass="field-hint"/>
                                            <Label fx:id="scoreError"
                                                   styleClass="error-label"
                                                   visible="false"
                                                   managed="false"/>
                                        </HBox>
                                    </VBox>

                                    <!-- Score Visualization -->
                                    <VBox spacing="10" styleClass="score-visual">
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-low"/>
                                            <Label text="Échec (0-49)" styleClass="score-label"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-medium"/>
                                            <Label text="Réussite (50-79)" styleClass="score-label"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-high"/>
                                            <Label text="Excellent (80-100)" styleClass="score-label"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- Creator ID Section -->
                            <VBox spacing="12" alignment="TOP_LEFT">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="field-icon-wrapper">
                                        <Circle radius="5" styleClass="field-icon-dot"/>
                                    </StackPane>
                                    <Label text="Creator Identification"
                                           styleClass="field-title"/>
                                    <Label text="Required"
                                           styleClass="badge-required"/>
                                </HBox>

                                <VBox spacing="12">
                                    <!-- Creator ID Input with Error -->
                                    <VBox spacing="8">
                                        <TextField fx:id="createdByIdField"
                                                   promptText="Votre ID utilisateur"
                                                   styleClass="input-field">
                                            <VBox.margin>
                                                <Insets/>
                                            </VBox.margin>
                                        </TextField>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="Cet ID sera associé à la mission"
                                                   styleClass="field-hint"/>
                                            <Label fx:id="creatorIdError"
                                                   styleClass="error-label"
                                                   visible="false"
                                                   managed="false"/>
                                        </HBox>
                                    </VBox>

                                    <!-- Identity Verification -->
                                    <VBox spacing="10" styleClass="verify-panel">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="✓" styleClass="verify-icon"/>
                                            <Label text="Créateur vérifié" styleClass="verify-text"/>
                                        </HBox>
                                        <Label text="Suivi des actions"
                                               styleClass="verify-subtext"
                                               wrapText="true"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- Quick Stats -->
                            <VBox spacing="10" styleClass="quick-stats">
                                <Label text="Aperçu de la mission" styleClass="stats-title"/>
                                <Separator styleClass="stats-separator"/>
                                <HBox spacing="20" alignment="CENTER_LEFT">
                                    <VBox spacing="5">
                                        <Label text="Longueur" styleClass="stat-label"/>
                                        <Label fx:id="previewLength" text="0" styleClass="stat-value"/>
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label text="Score" styleClass="stat-label"/>
                                        <Label fx:id="previewScore" text="-" styleClass="stat-value"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Form Actions -->
                    <HBox spacing="20" alignment="CENTER" styleClass="form-actions">
                        <Button text="Réinitialiser"
                                onAction="#resetForm"
                                styleClass="secondary-button"/>
                        <Button fx:id="submitButton"
                                text="Lancer la mission"
                                onAction="#ajouterMission"
                                styleClass="submit-button">
                            <graphic>
                                <Label text="→" styleClass="button-arrow"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Submit Section -->
                <VBox spacing="24" alignment="CENTER" styleClass="submit-section">

                    <!-- Divider -->
                    <StackPane>
                        <Rectangle styleClass="divider-line"/>
                    </StackPane>

                    <!-- Trust Indicators -->
                    <HBox spacing="32" alignment="CENTER" styleClass="trust-badges">
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="⚡" styleClass="trust-icon"/>
                            <Label text="Traitement instantané" styleClass="trust-text"/>
                        </HBox>
                        <Label text="·" styleClass="trust-separator"/>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="🔒" styleClass="trust-icon"/>
                            <Label text="Sécurisé" styleClass="trust-text"/>
                        </HBox>
                        <Label text="·" styleClass="trust-separator"/>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="📊" styleClass="trust-icon"/>
                            <Label text="Mise à jour en temps réel" styleClass="trust-text"/>
                        </HBox>
                    </HBox>

                    <!-- Version Info -->
                    <Label text="Mission Control v2.0" styleClass="version-info"/>
                </VBox>
            </VBox>

            <!-- Bottom Spacer -->
            <VBox styleClass="bottom-spacer"/>

        </VBox>
    </ScrollPane>
</StackPane>