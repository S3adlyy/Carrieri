<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.MissionAddController"
           stylesheets="@mission-styles.css"
           styleClass="root-container">

    <!-- Animated Background Orbs -->
    <Circle radius="180" styleClass="bg-orb-1"/>
    <Circle radius="140" styleClass="bg-orb-2"/>
    <Circle radius="100" styleClass="bg-orb-3"/>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" styleClass="main-scroll">
        <VBox alignment="TOP_CENTER" spacing="0" styleClass="content-wrapper">

            <!-- Header -->
            <VBox spacing="24" alignment="CENTER" styleClass="header-section">

                <!-- Icon with Pulse Animation -->
                <StackPane styleClass="icon-container">
                    <Circle radius="30" styleClass="icon-pulse"/>
                    <Circle radius="26" styleClass="icon-bg"/>
                    <Label text="✦" styleClass="icon-symbol"/>
                </StackPane>

                <!-- Title Group -->
                <VBox spacing="10" alignment="CENTER" maxWidth="680">
                    <Label text="Mission Control"
                           styleClass="main-title"/>

                    <Label text="Define your mission parameters with precision"
                           styleClass="subtitle"
                           wrapText="true"/>

                    <!-- Decorative Accent Line -->
                    <StackPane styleClass="accent-line-container">
                        <Rectangle styleClass="accent-line"/>
                    </StackPane>
                </VBox>
            </VBox>

            <!-- Main Form Card -->
            <VBox styleClass="form-card">
                <VBox spacing="32" alignment="TOP_CENTER" maxWidth="1100">

                    <!-- ALL FIELDS IN HORIZONTAL LAYOUT -->
                    <HBox spacing="40" alignment="TOP_CENTER" styleClass="horizontal-form-container">

                        <!-- LEFT COLUMN: Mission Description -->
                        <VBox spacing="12" alignment="TOP_LEFT" styleClass="form-column" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane styleClass="field-icon-wrapper">
                                    <Circle radius="5" styleClass="field-icon-dot"/>
                                </StackPane>
                                <Label text="Mission Description"
                                       styleClass="field-title"/>
                                <Label text="Required"
                                       styleClass="badge-required"/>
                            </HBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <TextArea fx:id="descriptionField"
                                          promptText="Describe the mission objectives, deliverables, and evaluation criteria..."
                                          styleClass="input-area-horizontal"
                                          wrapText="true">
                                    <VBox.margin>
                                        <Insets/>
                                    </VBox.margin>
                                </TextArea>
                                <Label text="Minimum 50 characters recommended"
                                       styleClass="field-hint"/>
                            </VBox>

                            <!-- Tips Panel Below Description -->
                            <VBox spacing="12" styleClass="tips-panel-horizontal">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="💡" styleClass="tips-icon"/>
                                    <Label text="Best Practices" styleClass="tips-title"/>
                                </HBox>

                                <VBox spacing="8">
                                    <Label text="• Be specific about objectives"
                                           styleClass="tips-item"/>
                                    <Label text="• Define clear deliverables"
                                           styleClass="tips-item"/>
                                    <Label text="• Mention evaluation criteria"
                                           styleClass="tips-item"/>
                                    <Label text="• Include any constraints"
                                           styleClass="tips-item"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- RIGHT COLUMN: Score and Creator -->
                        <VBox spacing="32" alignment="TOP_LEFT" styleClass="form-column" prefWidth="400">

                            <!-- Minimum Score Section -->
                            <VBox spacing="12" alignment="TOP_LEFT">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="field-icon-wrapper">
                                        <Circle radius="5" styleClass="field-icon-dot"/>
                                    </StackPane>
                                    <Label text="Minimum Passing Score"
                                           styleClass="field-title"/>
                                    <Label text="0-100"
                                           styleClass="badge-info"/>
                                </HBox>

                                <VBox spacing="12">
                                    <!-- Score Input -->
                                    <VBox spacing="8">
                                        <TextField fx:id="scoreField"
                                                   promptText="Enter score (e.g., 75)"
                                                   styleClass="input-field">
                                            <VBox.margin>
                                                <Insets/>
                                            </VBox.margin>
                                        </TextField>
                                        <Label text="Candidates must achieve this percentage to pass"
                                               styleClass="field-hint"/>
                                    </VBox>

                                    <!-- Score Visualization -->
                                    <VBox spacing="10" styleClass="score-visual">
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-low"/>
                                            <Label text="Fail" styleClass="score-label"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-medium"/>
                                            <Label text="Pass" styleClass="score-label"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="●" styleClass="score-dot score-high"/>
                                            <Label text="Excellent" styleClass="score-label"/>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- Creator ID Section -->
                            <VBox spacing="12" alignment="TOP_LEFT">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane styleClass="field-icon-wrapper">
                                        <Circle radius="5" styleClass="field-icon-dot"/>
                                    </StackPane>
                                    <Label text="Creator Identification"
                                           styleClass="field-title"/>
                                    <Label text="Auto-filled"
                                           styleClass="badge-auto"/>
                                </HBox>

                                <VBox spacing="12">
                                    <!-- Creator ID Input -->
                                    <VBox spacing="8">
                                        <TextField fx:id="createdByIdField"
                                                   promptText="Your user ID"
                                                   styleClass="input-field">
                                            <VBox.margin>
                                                <Insets/>
                                            </VBox.margin>
                                        </TextField>
                                        <Label text="This ID will be associated with the mission"
                                               styleClass="field-hint"/>
                                    </VBox>

                                    <!-- Identity Verification -->
                                    <VBox spacing="10" styleClass="verify-panel">
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label text="✓" styleClass="verify-icon"/>
                                            <Label text="Verified Creator" styleClass="verify-text"/>
                                        </HBox>
                                        <Label text="Tracked for reporting"
                                               styleClass="verify-subtext"
                                               wrapText="true"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>

                <!-- Submit Section -->
                <VBox spacing="24" alignment="CENTER" styleClass="submit-section">

                    <!-- Divider -->
                    <StackPane>
                        <Rectangle styleClass="divider-line"/>
                    </StackPane>

                    <!-- Submit Button -->
                    <Button text="Launch Mission"
                            onAction="#ajouterMission"
                            styleClass="submit-button">
                        <graphic>
                            <Label text="→" styleClass="button-arrow"/>
                        </graphic>
                    </Button>

                    <!-- Trust Indicators -->
                    <HBox spacing="32" alignment="CENTER" styleClass="trust-badges">
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="⚡" styleClass="trust-icon"/>
                            <Label text="Instant Processing" styleClass="trust-text"/>
                        </HBox>
                        <Label text="·" styleClass="trust-separator"/>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="🔒" styleClass="trust-icon"/>
                            <Label text="Secure" styleClass="trust-text"/>
                        </HBox>
                        <Label text="·" styleClass="trust-separator"/>
                        <HBox spacing="8" alignment="CENTER">
                            <Label text="📊" styleClass="trust-icon"/>
                            <Label text="Real-time Updates" styleClass="trust-text"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Bottom Spacer -->
            <VBox styleClass="bottom-spacer"/>

        </VBox>
    </ScrollPane>
</StackPane>
