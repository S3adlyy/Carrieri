<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.MissionEditController"
           stylesheets="@mission-edit-styles.css"
           alignment="CENTER"
           style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #0a66c2 0%, #378fe9 50%, #8b5cf6 100%);">

    <!-- Background Circles -->
    <Circle radius="80" fill="rgba(255,255,255,0.1)">
        <translateY>-150</translateY>
        <translateX>-200</translateX>
    </Circle>

    <Circle radius="60" fill="rgba(255,255,255,0.08)">
        <translateY>200</translateY>
        <translateX>250</translateX>
    </Circle>

    <Circle radius="40" fill="rgba(255,255,255,0.05)">
        <translateY>-100</translateY>
        <translateX>180</translateX>
    </Circle>

    <!-- Main Form Container -->
    <VBox styleClass="mission-form-container"
          spacing="30"
          alignment="CENTER"
          prefWidth="600"
          maxWidth="600">

        <!-- Header -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="✏️ Edit Mission" styleClass="mission-h1"/>
            <Label text="Update mission details"
                   style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: 500;"/>
        </VBox>

        <!-- Form Fields -->
        <GridPane hgap="25" vgap="25" styleClass="grid-pane">
            <columnConstraints>
                <ColumnConstraints percentWidth="35" halignment="RIGHT"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>

            <!-- Description Field -->
            <Label text="Description:"
                   styleClass="white-text"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>
            <TextField fx:id="descriptionField"
                       promptText="Enter mission description..."
                       prefWidth="350"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

            <!-- Min Score Field -->
            <Label text="Min Score (%):"
                   styleClass="white-text"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>
            <TextField fx:id="scoreField"
                       promptText="Enter minimum score (0-100)..."
                       prefWidth="350"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

            <!-- Creator ID Field -->
            <Label text="Creator ID:"
                   styleClass="white-text"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>
            <TextField fx:id="creatorField"
                       promptText="Enter creator user ID..."
                       prefWidth="350"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Action Buttons -->
        <HBox spacing="25" alignment="CENTER" style="-fx-padding: 10px 0 0 0;">
            <Button text="💾 Save Changes"
                    onAction="#saveMission"
                    styleClass="mission-btn"
                    graphicTextGap="8"/>

            <Button text="↩ Cancel"
                    onAction="#cancel"
                    styleClass="mission-btn-outline"
                    graphicTextGap="8"/>
        </HBox>

        <!-- Help Text -->
        <Label text="💡 All fields are required. Score must be between 0 and 100."
               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-padding: 20 0 0 0;"/>
    </VBox>
</StackPane>