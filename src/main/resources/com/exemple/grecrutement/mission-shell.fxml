<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<?import javafx.scene.shape.Circle?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.exemple.grecrutement.MissionShellController"
            stylesheets="@app.css">

    <!-- Top: Navbar -->
    <top>
        <HBox styleClass="navBar" spacing="12" alignment="CENTER_LEFT">
            <!-- Logo/Brand Section -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Region styleClass="navBrandDot"/>
                <Label text="Carrieri" styleClass="navBrand"/>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Mission Navigation Buttons -->
            <HBox spacing="6" alignment="CENTER" styleClass="navLinks">
                <Button fx:id="btnAddMission"
                        text="➕ Add Mission"
                        onAction="#showAddMission"
                        styleClass="navLinkBtn"/>

                <Button fx:id="btnMissionList"
                        text="📋 Mission List"
                        onAction="#showMissionList"
                        styleClass="navLinkBtn"/>

                <Button fx:id="btnSubmitRendu"
                        text="🤖 Submit Rendu"
                        onAction="#showRenduAdd"
                        styleClass="navLinkBtn"/>

                <Button fx:id="btnRenduList"
                        text="📑 Rendu List"
                        onAction="#showRenduList"
                        styleClass="navLinkBtn"/>
            </HBox>

            <!-- Right Side Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Section -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Circle fx:id="navAvatar" radius="14" styleClass="navAvatar"/>
                <Label fx:id="navNameLabel" text="User" styleClass="navName"/>
            </HBox>
        </HBox>
    </top>

    <!-- Center: Content Area -->
    <center>
        <StackPane fx:id="contentPane" />
    </center>

</BorderPane>