<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.exemple.grecrutement.MissionShellController"
            stylesheets="@navbar.css"
            styleClass="mission-bg">

    <!-- Enhanced Glass Navbar with Liquid Effects -->
    <top>
        <VBox styleClass="mission-header" prefHeight="70">
            <!-- Main navbar container -->
            <HBox fx:id="navbarContainer" styleClass="navbar-container"
                  alignment="CENTER" prefHeight="70">

                <!-- Left spacer -->
                <Region HBox.hgrow="ALWAYS"/>

                <!-- Navbar buttons -->
                <Button fx:id="btnAddMission"
                        text="➕ Add Mission"
                        onAction="#showAddMission"
                        styleClass="liquid-btn"/>

                <Button fx:id="btnMissionList"
                        text="📋 Mission List"
                        onAction="#showMissionList"
                        styleClass="liquid-btn-outline"/>

                <Button fx:id="btnSubmitRendu"
                        text="🤖 Submit Rendu"
                        onAction="#showRenduAdd"
                        styleClass="liquid-btn"/>

                <Button fx:id="btnRenduList"
                        text="📑 Rendu List"
                        onAction="#showRenduList"
                        styleClass="liquid-btn-outline"/>

                <!-- Right spacer -->
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Glass effect bottom border -->
            <Rectangle height="1"
                       styleClass="glass-overlay"
                       fill="linear-gradient(to right,
                            transparent,
                            rgba(255,255,255,0.3),
                            transparent)"/>
        </VBox>
    </top>

    <!-- Content Area with Ripple Container -->
    <center>
        <StackPane fx:id="contentPane"
                   styleClass="liquid-ripple-container"/>
    </center>

</BorderPane>