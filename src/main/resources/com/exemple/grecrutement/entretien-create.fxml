<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.EntretienCreateController"
           stylesheets="@mission-styles.css"
           styleClass="prf-bg"
           style="-fx-padding: 40;">

    <!-- Background Elements -->
    <Circle radius="120" fill="rgba(159,134,192,0.03)" style="-fx-translate-y: -180; -fx-translate-x: -320;"/>
    <Circle radius="90" fill="rgba(190,149,196,0.02)" style="-fx-translate-y: 120; -fx-translate-x: 280;"/>

    <!-- Scrollable Container -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
        <VBox alignment="TOP_CENTER" spacing="0">

            <!-- Header Section -->
            <VBox spacing="20" alignment="CENTER" style="-fx-padding: 0 0 35 0;">
                <!-- Icon Badge -->
                <StackPane style="-fx-background-color: linear-gradient(135deg, #231942 0%, #5E548E 100%);
                                 -fx-background-radius: 20;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.3), 25, 0.25, 0, 10);">
                    <Label text="📅" style="-fx-font-size: 34px; -fx-text-fill: white;"/>
                </StackPane>

                <!-- Title Section -->
                <VBox spacing="10" alignment="CENTER" maxWidth="700">
                    <Label text="Schedule Interview"
                           style="-fx-font-size: 36px;
                                  -fx-font-weight: 900;
                                  -fx-text-fill: #231942;
                                  -fx-letter-spacing: -0.8px;
                                  -fx-padding: 0 0 5 0;" />

                    <Label text="Create a new interview meeting with the candidate"
                           style="-fx-font-size: 17px;
                                  -fx-text-fill: rgba(35,25,66,0.8);
                                  -fx-font-weight: 500;
                                  -fx-text-alignment: center;
                                  -fx-wrap-text: true;
                                  -fx-line-spacing: 1.6;" />

                    <!-- Divider -->
                    <HBox alignment="CENTER" style="-fx-padding: 18 0 5 0;">
                        <HBox style="-fx-background-color: linear-gradient(to right, transparent 0%, #BE95C4 50%, transparent 100%);
                                    -fx-min-height: 2px;
                                    -fx-pref-width: 200px;
                                    -fx-opacity: 0.4;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Form Card -->
            <VBox styleClass="prf-heroCard"
                  alignment="TOP_CENTER"
                  style="-fx-padding: 45 60 50 60;
                         -fx-background-radius: 20;
                         -fx-border-radius: 20;
                         -fx-effect: dropshadow(gaussian, rgba(35,25,66,0.14), 40, 0.25, 0, 18);
                         -fx-max-width: 900;">

                <!-- Candidate Info Display -->
                <VBox spacing="15" style="-fx-padding: 0 0 30 0;" maxWidth="800">
                    <Label text="👤 Candidate Information"
                           style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #231942;"/>

                    <Label fx:id="lblCandidatInfo"
                           text="Select a candidate from Rendu List"
                           style="-fx-font-size: 14px; -fx-padding: 12 16;
                                  -fx-background-color: #f8f9fa; -fx-background-radius: 8;
                                  -fx-border-color: #e9ecef; -fx-border-radius: 8;"/>

                    <HBox spacing="20" maxWidth="800">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Candidate ID" style="-fx-font-size: 13px; -fx-text-fill: rgba(35,25,66,0.7); -fx-font-weight: 700;"/>
                            <TextField fx:id="txtCandidatId"
                                       editable="false"
                                       styleClass="prf-editorField"
                                       style="-fx-opacity: 0.6;"/>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Candidate Email *" style="-fx-font-size: 13px; -fx-text-fill: rgba(35,25,66,0.7); -fx-font-weight: 700;"/>
                            <TextField fx:id="txtCandidatEmail"
                                       promptText="candidate@email.com"
                                       styleClass="prf-editorField"/>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Candidate Name *" style="-fx-font-size: 13px; -fx-text-fill: rgba(35,25,66,0.7); -fx-font-weight: 700;"/>
                            <TextField fx:id="txtCandidatName"
                                       promptText="Enter candidate name"
                                       styleClass="prf-editorField"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Separator -->
                <HBox alignment="CENTER" style="-fx-padding: 10 0 30 0;">
                    <HBox style="-fx-background-color: linear-gradient(to right, transparent, rgba(159,134,192,0.3), transparent);
                                -fx-min-height: 1.5px;
                                -fx-pref-width: 100%;"/>
                </HBox>

                <!-- Interview Details - Simplified Layout -->
                <VBox spacing="30" alignment="TOP_CENTER" maxWidth="800">
                    <!-- Row 1: Date -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Interview Date"
                                   style="-fx-font-size: 16.5px; -fx-font-weight: 900; -fx-text-fill: #231942;"/>
                            <Label text="(Required field)"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.55); -fx-font-weight: 700; -fx-font-style: italic;"/>
                        </HBox>
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <DatePicker fx:id="datePicker"
                                        promptText="Select date"
                                        styleClass="prf-editorField"
                                        style="-fx-pref-width: 300;"/>
                            <Label text="📅 Choose the interview date"
                                   style="-fx-font-size: 14px; -fx-text-fill: rgba(35,25,66,0.75); -fx-wrap-text: true; -fx-font-weight: 700;"/>
                        </HBox>
                    </VBox>

                    <!-- Row 2: Time -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Interview Time"
                                   style="-fx-font-size: 16.5px; -fx-font-weight: 900; -fx-text-fill: #231942;"/>
                            <Label text="(Required field)"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.55); -fx-font-weight: 700; -fx-font-style: italic;"/>
                        </HBox>
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Hour" style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.6);"/>
                                    <ComboBox fx:id="comboHour"
                                              styleClass="prf-editorField"
                                              prefWidth="100"/>
                                </VBox>
                                <Label text=":" style="-fx-font-size: 24px; -fx-text-fill: #5E548E; -fx-padding: 20 0 0 0;"/>
                                <VBox spacing="5">
                                    <Label text="Minute" style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.6);"/>
                                    <ComboBox fx:id="comboMinute"
                                              styleClass="prf-editorField"
                                              prefWidth="100"/>
                                </VBox>
                            </HBox>
                            <Label text="🕐 Select hour and minute"
                                   style="-fx-font-size: 14px; -fx-text-fill: rgba(35,25,66,0.75); -fx-wrap-text: true; -fx-font-weight: 700;"/>
                        </HBox>
                    </VBox>

                    <!-- Row 3: Type -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Interview Type"
                                   style="-fx-font-size: 16.5px; -fx-font-weight: 900; -fx-text-fill: #231942;"/>
                            <Label text="(Required field)"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.55); -fx-font-weight: 700; -fx-font-style: italic;"/>
                        </HBox>
                        <HBox spacing="30" alignment="CENTER_LEFT">
                            <ComboBox fx:id="comboType"
                                      promptText="Select interview type"
                                      styleClass="prf-editorField"
                                      style="-fx-pref-width: 300;"/>
                            <Label text="🎯 Type of interview (Technical, HR, etc.)"
                                   style="-fx-font-size: 14px; -fx-text-fill: rgba(35,25,66,0.75); -fx-wrap-text: true; -fx-font-weight: 700;"/>
                        </HBox>
                    </VBox>

                    <!-- Row 4: Notes (Optional) -->
                    <VBox spacing="10" alignment="TOP_LEFT">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Notes"
                                   style="-fx-font-size: 16.5px; -fx-font-weight: 900; -fx-text-fill: #231942;"/>
                            <Label text="(Optional)"
                                   style="-fx-font-size: 12px; -fx-text-fill: rgba(35,25,66,0.55); -fx-font-weight: 700; -fx-font-style: italic;"/>
                        </HBox>
                        <HBox spacing="30" alignment="TOP_LEFT">
                            <TextArea fx:id="txtNotes"
                                      promptText="Add any additional notes or instructions..."
                                      styleClass="prf-editorArea"
                                      style="-fx-pref-width: 300; -fx-pref-height: 100;"/>
                            <Label text="📝 Internal notes (not sent to candidate)"
                                   style="-fx-font-size: 14px; -fx-text-fill: rgba(35,25,66,0.75); -fx-wrap-text: true; -fx-font-weight: 700;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Status Label -->
                <HBox alignment="CENTER" style="-fx-padding: 20 0;">
                    <Label fx:id="lblStatus"
                           text=""
                           style="-fx-font-size: 14px;"/>
                </HBox>

                <!-- Action Buttons -->
                <VBox spacing="25" alignment="CENTER" style="-fx-padding: 30 0 10 0;">
                    <!-- Decorative Line -->
                    <HBox alignment="CENTER">
                        <HBox style="-fx-background-color: linear-gradient(to right, transparent, rgba(159,134,192,0.3), transparent);
                                    -fx-min-height: 1.5px;
                                    -fx-pref-width: 350px;"/>
                    </HBox>

                    <!-- Buttons -->
                    <HBox spacing="20" alignment="CENTER">
                        <Button text="📅 Schedule Interview"
                                fx:id="btnSchedule"
                                onAction="#scheduleInterview"
                                style="-fx-background-color: linear-gradient(135deg, #10b981 0%, #059669 100%);
                                       -fx-text-fill: white;
                                       -fx-font-size: 16px;
                                       -fx-font-weight: 900;
                                       -fx-padding: 16 40;
                                       -fx-background-radius: 50;
                                       -fx-min-width: 220;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.35), 25, 0.25, 0, 10);"/>

                        <Button text="❌ Cancel"
                                onAction="#cancel"
                                style="-fx-background-color: linear-gradient(135deg, #6b7280 0%, #4b5563 100%);
                                       -fx-text-fill: white;
                                       -fx-font-size: 16px;
                                       -fx-font-weight: 900;
                                       -fx-padding: 16 40;
                                       -fx-background-radius: 50;
                                       -fx-min-width: 150;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(107,114,128,0.35), 25, 0.25, 0, 10);"/>
                    </HBox>

                    <!-- Info -->
                    <HBox spacing="25" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <Label text="📧 Email notification will be sent"
                               style="-fx-font-size: 12.5px; -fx-text-fill: rgba(94,84,142,0.7); -fx-font-weight: 700;"/>
                        <Label text="•" style="-fx-font-size: 14px; -fx-text-fill: rgba(159,134,192,0.5);"/>
                        <Label text="📅 Calendar invite included"
                               style="-fx-font-size: 12.5px; -fx-text-fill: rgba(94,84,142,0.7); -fx-font-weight: 700;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>