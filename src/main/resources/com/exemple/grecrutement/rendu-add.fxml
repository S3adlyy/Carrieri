<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.exemple.grecrutement.RenduAddController"
           stylesheets="@rendu-styles.css"
           styleClass="prf-bg"
           style="-fx-padding: 40;">

    <!-- Subtle Background Elements -->
    <Circle radius="100" fill="rgba(159,134,192,0.03)" style="-fx-translate-y: -150; -fx-translate-x: -300;"/>
    <Circle radius="70" fill="rgba(190,149,196,0.02)" style="-fx-translate-y: 120; -fx-translate-x: 280;"/>
    <Circle radius="50" fill="rgba(224,177,203,0.01)" style="-fx-translate-y: -80; -fx-translate-x: 350;"/>

    <!-- Scrollable Container -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
        <!-- Main Container - Centered -->
        <VBox styleClass="main-container" maxWidth="1200" alignment="TOP_CENTER">
            <!-- Header Section -->
            <VBox styleClass="header-section" spacing="10" alignment="TOP_CENTER">
                <HBox spacing="15" alignment="CENTER">
                    <StackPane style="-fx-background-color: linear-gradient(135deg, #231942 0%, #5E548E 100%);
                                     -fx-background-radius: 14;
                                     -fx-padding: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(94,84,142,0.25), 20, 0.2, 0, 6);">
                        <Label text="🤖" style="-fx-font-size: 24px; -fx-text-fill: white;"/>
                    </StackPane>
                    <VBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="AI Code Submission" styleClass="main-title"/>
                        <Label text="Submit Python code for AI evaluation" styleClass="sub-title"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Centered Split Layout Container -->
            <HBox styleClass="split-container" spacing="30" alignment="CENTER">
                <!-- LEFT: Form Section -->
                <VBox styleClass="form-section" spacing="25" prefWidth="450" alignment="TOP_LEFT">
                    <!-- Form Title -->
                    <Label text="📝 Submission Form" styleClass="section-title"/>

                    <!-- Form Fields -->
                    <VBox spacing="20">
                        <!-- Candidate ID -->
                        <VBox spacing="6">
                            <Label text="👤 Candidate ID" styleClass="field-label"/>
                            <TextField fx:id="txtCandidatId"
                                       promptText="Enter candidate ID"
                                       styleClass="form-field"/>
                        </VBox>

                        <!-- Mission ID -->
                        <VBox spacing="6">
                            <Label text="🎯 Mission ID" styleClass="field-label"/>
                            <TextField fx:id="txtMissionId"
                                       promptText="Will be auto-filled when you select a mission"
                                       styleClass="form-field"
                                       editable="true"/>
                        </VBox>

                        <!-- Mission Type -->
                        <VBox spacing="6">
                            <Label text="📋 Mission Type" styleClass="field-label"/>
                            <ComboBox fx:id="comboMissionType"
                                      promptText="Select mission type"
                                      styleClass="form-combo"/>
                        </VBox>
                    </VBox>

                    <!-- Mission Description Display -->
                    <VBox spacing="12" style="-fx-padding: 20px 0;">
                        <Label text="📄 Mission Details" styleClass="section-title"/>
                        <TextArea fx:id="lblMissionDescription"
                                  editable="false"
                                  wrapText="true"
                                  prefHeight="160"
                                  styleClass="mission-description-area"/>
                    </VBox>

                    <!-- ================ TIMER SECTION ================ -->
                    <VBox spacing="15" style="-fx-padding: 10px 0 20px 0;"
                          fx:id="timerContainer">
                        <!-- Note: visible and managed are controlled by controller,
                             removed from FXML to avoid parsing error -->

                        <!-- Timer Header -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: linear-gradient(135deg, #231942 0%, #5E548E 100%);
                                             -fx-background-radius: 8;
                                             -fx-padding: 8;">
                                <Label text="⏱️" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
                            </StackPane>
                            <Label text="Time Remaining" styleClass="field-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="20:00" style="-fx-text-fill: #64748b; -fx-font-size: 12px;">
                                <graphic>
                                    <Label text="⏳" style="-fx-font-size: 12px;"/>
                                </graphic>
                            </Label>
                        </HBox>

                        <!-- Timer Display Card -->
                        <VBox spacing="15" styleClass="timer-card">
                            <!-- Timer Circle and Display -->
                            <HBox spacing="20" alignment="CENTER">
                                <StackPane>
                                    <Circle radius="40" fill="rgba(94,84,142,0.08)" stroke="#5E548E" strokeWidth="2.5"/>
                                    <Circle radius="35" fill="white" stroke="transparent"/>
                                    <Label fx:id="lblTimer" text="20:00"
                                           styleClass="timer-display"/>
                                </StackPane>

                                <VBox spacing="5" alignment="CENTER_LEFT">
                                    <Label text="Mission Time" style="-fx-text-fill: #231942; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    <Label text="20 minutes" style="-fx-text-fill: #5E548E; -fx-font-size: 13px;"/>
                                    <HBox spacing="5" alignment="CENTER_LEFT">
                                        <Circle radius="4" fill="#10b981"/>
                                        <Label text="Active" style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <!-- Timer Progress Bar -->
                            <VBox spacing="8">
                                <HBox spacing="5" alignment="CENTER_LEFT">
                                    <Label text="Progress" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblTimerProgress" text="100%"
                                           style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: 600;"/>
                                </HBox>
                                <ProgressBar fx:id="timerProgressBar"
                                             prefWidth="400"
                                             prefHeight="10"
                                             progress="1.0"
                                             styleClass="timer-progress-bar"/>
                            </VBox>

                            <!-- Timer Warning Label -->
                            <Label fx:id="lblTimerWarning"
                                   text="⏳ Take your time, but stay aware of the deadline"
                                   styleClass="timer-warning-label"
                                   wrapText="true"/>
                        </VBox>
                    </VBox>
                    <!-- ============== END TIMER SECTION ============== -->

                    <!-- ============== SECURITY WARNING SECTION ============== -->
                    <VBox fx:id="securityWarningContainer"
                          spacing="10"
                          styleClass="security-warning-card">
                        <!-- Note: visible and managed are controlled by controller,
                             removed from FXML to avoid parsing error -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: #F59E0B; -fx-background-radius: 6; -fx-padding: 6;">
                                <Label text="⚠️" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
                            </StackPane>
                            <VBox spacing="2">
                                <Label text="Security Alert"
                                       style="-fx-text-fill: #92400E; -fx-font-weight: 900; -fx-font-size: 13px;"/>
                                <Label fx:id="lblSecurityWarning"
                                       text="Copy/paste is disabled during missions"
                                       style="-fx-text-fill: #92400E; -fx-font-size: 12px;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="✕"
                                    style="-fx-background-color: transparent; -fx-text-fill: #92400E; -fx-font-size: 14px; -fx-cursor: hand;"
                                    onAction="#hideSecurityWarning"/>
                        </HBox>
                    </VBox>
                    <!-- ============== END SECURITY WARNING SECTION ============== -->

                    <!-- Evaluate Button -->
                    <VBox spacing="15" style="-fx-padding: 15px 0;">
                        <Button id="btnEvaluer"
                                text="🚀 Evaluate with AI"
                                onAction="#evaluer"
                                styleClass="evaluate-button"
                                prefWidth="220"/>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ProgressIndicator fx:id="progress"
                                               styleClass="progress-indicator"
                                               visible="false"/>
                            <Label fx:id="lblProcessing"
                                   text="⏳ Processing..."
                                   styleClass="processing-label"
                                   visible="false"/>
                        </HBox>
                    </VBox>

                    <!-- Result -->
                    <Label fx:id="lblResultat"
                           text="👉 Waiting for code submission..."
                           styleClass="result-label"
                           wrapText="true"/>
                </VBox>

                <!-- RIGHT: Code Editor Section -->
                <VBox styleClass="editor-section" spacing="20" prefWidth="650" alignment="TOP_LEFT">
                    <!-- Editor Title -->
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <StackPane style="-fx-background-color: linear-gradient(135deg, #5E548E 0%, #9F86C0 100%);
                                         -fx-background-radius: 12;
                                         -fx-padding: 10;
                                         -fx-effect: dropshadow(gaussian, rgba(159,134,192,0.25), 15, 0.2, 0, 5);">
                            <Label text="💻" style="-fx-font-size: 20px; -fx-text-fill: white;"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Python Code Editor" styleClass="section-title"/>
                            <Label text="Write your solution in Python 3" styleClass="editor-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <!-- Security Badge -->
                        <HBox spacing="5" styleClass="security-badge">
                            <Label text="🔒" style="-fx-font-size: 12px;"/>
                            <Label text="Secure Mode" style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: 700;"/>
                        </HBox>
                    </HBox>

                    <!-- Code Editor Container -->
                    <VBox styleClass="code-editor-container">
                        <!-- Editor Header -->
                        <HBox styleClass="editor-header">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="📁" style="-fx-font-size: 16px; -fx-text-fill: #E0B1CB;"/>
                                <Label text="solution.py" styleClass="file-name"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Python 3" styleClass="language-tag"/>
                            <Line startX="0" startY="0" endX="0" endY="20"
                                  style="-fx-stroke: #334155; -fx-stroke-width: 1;"
                                  HBox.hgrow="NEVER">
                                <HBox.margin>
                                    <Insets left="10" right="10"/>
                                </HBox.margin>
                            </Line>
                            <Label text="No Copy/Paste" styleClass="restriction-tag"/>
                        </HBox>

                        <!-- Code Editor -->
                        <TextArea fx:id="txtCode"
                                  promptText="# Write your Python solution here&#10;# Example: Add two numbers&#10;&#10;def add(a, b):&#10;    return a + b&#10;&#10;# Read input and call function&#10;if __name__ == '__main__':&#10;    num1 = int(input())&#10;    num2 = int(input())&#10;    print(add(num1, num2))"
                                  styleClass="code-editor"/>
                    </VBox>

                    <!-- Editor Security Tips -->
                    <VBox spacing="8" styleClass="editor-tips-container">
                        <HBox styleClass="editor-tips">
                            <Label text="🔒" style="-fx-font-size: 14px;"/>
                            <Label text="Security: " style="-fx-text-fill: #5E548E; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                            <Label text="Copy, paste, and right-click are disabled"
                                   styleClass="tip-text"/>
                        </HBox>
                        <HBox styleClass="editor-tips">
                            <Label text="⏱️" style="-fx-font-size: 14px;"/>
                            <Label text="Timer: " style="-fx-text-fill: #5E548E; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                            <Label text="Your code will auto-submit when time expires"
                                   styleClass="tip-text"/>
                        </HBox>
                        <HBox styleClass="editor-tips">
                            <Label text="💡" style="-fx-font-size: 14px;"/>
                            <Label text="Tip: " style="-fx-text-fill: #5E548E; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                            <Label text="Test your code with sample inputs before submitting"
                                   styleClass="tip-text"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Footer -->
            <HBox alignment="CENTER" styleClass="footer-container">
                <Label text="🔍 Double-click a mission in Mission List to auto-fill details • Timer starts automatically • 20:00 minutes allocated"
                       styleClass="footer-text"/>
            </HBox>
        </VBox>
    </ScrollPane>
</StackPane>