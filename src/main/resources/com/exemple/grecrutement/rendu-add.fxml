<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.exemple.grecrutement.RenduAddController"
            stylesheets="@rendu-styles.css"
            styleClass="root"
            fx:id="rootBorderPane">

    <top>
        <!-- Header avec Timer -->
        <HBox styleClass="header" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Label text="🤖" styleClass="header-icon"/>
            <VBox spacing="2">
                <Label text="AI Code Submission" styleClass="header-title"/>
                <Label text="Submit Python code for AI evaluation" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="timer-box" spacing="10" alignment="CENTER">
                <Label text="⏱️" styleClass="timer-icon"/>
                <Label fx:id="lblTimer" text="20:00" styleClass="timer-display"/>
                <Label text="remaining" styleClass="timer-label"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
            <VBox spacing="20" styleClass="main-content">
                <padding>
                    <Insets top="0" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Deux colonnes -->
                <HBox spacing="20" styleClass="columns">
                    <!-- Colonne gauche - Formulaire -->
                    <VBox spacing="15" styleClass="left-column" HBox.hgrow="ALWAYS">

                        <Label text="📝 Submission Form" styleClass="section-title"/>

                        <!-- Grille formulaire -->
                        <GridPane hgap="10" vgap="10" styleClass="form-grid">
                            <Label text="Candidate ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label text="Mission ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <TextField fx:id="txtCandidatId" promptText="Enter ID" styleClass="form-field"
                                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="txtMissionId" promptText="Auto-filled" styleClass="form-field"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Mission Type:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="comboMissionType" promptText="Select type" styleClass="form-combo"
                                      GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        </GridPane>

                        <!-- Mission Details -->
                        <VBox spacing="8" styleClass="details-box">
                            <Label text="📄 Mission Details" styleClass="details-title"/>
                            <TextArea fx:id="lblMissionDescription" editable="false" wrapText="true"
                                      prefHeight="80" styleClass="details-text"/>
                        </VBox>

                        <!-- Timer Progress -->
                        <VBox spacing="5" styleClass="timer-progress-box">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <ProgressBar fx:id="timerProgressBar" prefWidth="200" progress="1.0" styleClass="progress-bar"/>
                                <Label fx:id="lblTimerProgress" text="100%" styleClass="progress-label"/>
                            </HBox>
                        </VBox>

                        <!-- Bouton Submit -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="🚀 Submit Code" onAction="#evaluer" styleClass="submit-button"/>
                            <ProgressIndicator fx:id="progress" visible="false" prefWidth="20" prefHeight="20"/>
                            <Label fx:id="lblProcessing" text="Processing..." visible="false" styleClass="processing-label"/>
                        </HBox>

                        <!-- Console -->
                        <VBox spacing="5" styleClass="console-box">
                            <Label text="📟 Output Console" styleClass="console-title"/>
                            <Label fx:id="lblResultat" text="Waiting for code submission..."
                                   styleClass="console-output" wrapText="true" prefHeight="60"/>
                        </VBox>
                    </VBox>

                    <!-- Colonne droite - Éditeur -->
                    <VBox spacing="10" styleClass="right-column" HBox.hgrow="ALWAYS">

                        <!-- En-tête éditeur -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="💻" styleClass="editor-icon"/>
                            <Label text="Python Editor" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnFullScreen" text="⛶" onAction="#toggleFullScreen" styleClass="fullscreen-btn"/>
                            <HBox styleClass="security-badge" spacing="5">
                                <Label text="🔒"/>
                                <Label text="Secure Mode"/>
                            </HBox>
                        </HBox>

                        <!-- Éditeur de code -->
                        <VBox styleClass="editor-container">
                            <HBox styleClass="editor-header" spacing="10">
                                <Label text="📁 solution.py" styleClass="file-name"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Python 3" styleClass="lang-tag"/>
                                <Label text="No Copy/Paste" styleClass="restriction-tag"/>
                            </HBox>
                            <TextArea fx:id="txtCode" styleClass="code-editor" prefHeight="300" wrapText="false"
                                      promptText="# Write your Python solution here&#10;def add(a, b):&#10;    return a + b&#10;&#10;if __name__ == '__main__':&#10;    num1 = int(input())&#10;    num2 = int(input())&#10;    print(add(num1, num2))"/>
                        </VBox>

                        <!-- Status bar -->
                        <HBox spacing="15" styleClass="status-bar">
                            <Label text="🐍 Python 3"/>
                            <Label text="🔒 No Copy/Paste"/>
                            <Label text="⏱️ Auto-submit"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="F11" styleClass="shortcut"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <!-- Footer -->
        <HBox styleClass="footer" alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Double-click a mission to auto-fill • Timer: 20:00 • Secure Environment"
                   styleClass="footer-text"/>
        </HBox>
    </bottom>

</BorderPane>