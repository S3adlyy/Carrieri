<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.guser.controllers.greclam.TraitementFormController"
      spacing="20" style="-fx-padding: 20;" alignment="TOP_CENTER"
      prefWidth="600"
      stylesheets="@css/ThemeUnified.css">

    <!-- ✅ AJOUT du Label avec fx:id="dialogTitle" -->
    <Label fx:id="dialogTitle" text="Formulaire de traitement"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <!-- Section Informations de la réclamation -->
    <TitledPane text="Informations de la réclamation" expanded="true">
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label fx:id="reclamationObjetLabel" text="Objet: "
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-size: 14px;"/>
            <Label fx:id="reclamationDescriptionLabel" text="Description: "
                   wrapText="true" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
    </TitledPane>

    <!-- Formulaire de traitement -->
    <TitledPane text="Détails du traitement" expanded="true">
        <GridPane vgap="15" hgap="10" alignment="CENTER" style="-fx-padding: 10;">

            <Label text="Réclamation ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <TextField fx:id="reclamationIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefWidth="350" promptText="ID de la réclamation" editable="false"
                       style="-fx-background-color: #ecf0f1;"/>

            <Label text="User ID:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <TextField fx:id="adminIdField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       prefWidth="350" promptText="ID de l'administrateur" text="1"/>

            <Label text="Statut Final:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="statutFinalCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"
                      prefWidth="350" promptText="Sélectionner le statut"/>

            <Label text="Date Traitement:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"
                        prefWidth="350" promptText="jj/mm/aaaa"/>

            <Label text="Réponse Admin:" GridPane.rowIndex="4" GridPane.columnIndex="0"
                   style="-fx-font-weight: bold;"/>
            <TextArea fx:id="reponseArea" GridPane.rowIndex="4" GridPane.columnIndex="1"
                      prefRowCount="5" prefWidth="350" wrapText="true"
                      promptText="Écrivez votre réponse ici..."/>
        </GridPane>
    </TitledPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="✅ Sauvegarder le traitement" onAction="#handleSave"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 180; -fx-padding: 10; -fx-cursor: hand;"/>
    </HBox>
</VBox>