<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.guser.controllers.greclam.MainController"
            stylesheets="@css/ThemeUnified.css"
            styleClass="shell-root">

    <!-- Left Sidebar -->
    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar-animated"
              prefWidth="70" minWidth="70" maxWidth="70"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <!-- Brand -->
            <VBox styleClass="brand-container" alignment="CENTER">
                <Label fx:id="brandText" text="Carrieri" styleClass="brand-text"/>
                <Label fx:id="brandSubtext" text="Gestion des Réclamations" styleClass="brand-subtext"/>
            </VBox>

            <!-- Navigation -->
            <VBox styleClass="nav-container" alignment="CENTER">
                <!-- Section Réclamations -->
                <Button fx:id="btnReclamations" onAction="#showReclamationList" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📋" styleClass="nav-icon"/>
                            <Label fx:id="reclamationsText" text="Réclamations" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- BOUTON AJOUT RÉCLAMATION -->
                <Button fx:id="btnAjoutReclamation" onAction="#showReclamationForm" styleClass="nav-button-add">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="➕" styleClass="nav-icon-add"/>
                            <Label fx:id="ajoutReclamationText" text="Nouvelle" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Petit séparateur visuel -->
                <Region styleClass="nav-separator" prefHeight="5"/>

                <!-- Section Feedbacks -->
                <Button fx:id="btnFeedbacks" onAction="#showFeedbackList" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="⭐" styleClass="nav-icon"/>
                            <Label fx:id="feedbacksText" text="Feedbacks" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- BOUTON AJOUT FEEDBACK -->
                <Button fx:id="btnAjoutFeedback" onAction="#showFeedbackForm" styleClass="nav-button-add">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="➕" styleClass="nav-icon-add"/>
                            <Label fx:id="ajoutFeedbackText" text="Nouveau" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Petit séparateur visuel -->
                <Region styleClass="nav-separator" prefHeight="5"/>

                <!-- Section Traitements (sans bouton d'ajout) -->
                <Button fx:id="btnTraitements" onAction="#showTraitementList" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="⚡" styleClass="nav-icon"/>
                            <Label fx:id="traitementsText" text="Traitements" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
                <!-- ✅ BOUTON AJOUT TRAITEMENT SUPPRIMÉ -->
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- BOUTON DE THÈME -->
            <Button fx:id="btnTheme" styleClass="theme-toggle" text="🌙"/>

            <!-- User section -->
            <VBox styleClass="user-container" alignment="CENTER">
                <StackPane>
                    <Circle fx:id="userAvatar" radius="20" styleClass="user-avatar-glow"/>
                </StackPane>
                <Label fx:id="userName" text="Admin User" styleClass="user-name"/>
                <Label fx:id="userRole" text="Administrateur" styleClass="user-role"/>
                <Button text="🚪" onAction="#logout" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Content Area -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>
    <!-- Dans la section Navigation, avant les autres boutons -->
    <Button fx:id="btnDashboard" onAction="#showDashboard" styleClass="nav-button">
        <graphic>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="📊" styleClass="nav-icon"/>
                <Label text="Dashboard" styleClass="nav-text"/>
            </HBox>
        </graphic>
    </Button>

</BorderPane>