<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="main-scroll"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.guser.controllers.goffre.FavoritesListController"
stylesheets="@css/theme-unified.css">

    <StackPane>
        <!-- Cercles décoratifs en arrière-plan -->
        <Circle radius="250" fill="rgba(94,84,142,0.03)" mouseTransparent="true"
                style="-fx-translate-y: -150; -fx-translate-x: -280;" styleClass="bg-orb"/>
        <Circle radius="200" fill="rgba(159,134,192,0.02)" mouseTransparent="true"
                style="-fx-translate-y: 200; -fx-translate-x: 250;" styleClass="bg-orb-purple"/>
        <Circle radius="150" fill="rgba(224,177,203,0.02)" mouseTransparent="true"
                style="-fx-translate-y: -100; -fx-translate-x: 180;" styleClass="bg-orb-pink"/>

        <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 40;">

            <!-- En-tête -->
            <VBox spacing="15" alignment="CENTER" styleClass="header-section">
                <StackPane styleClass="header-icon-container">
                    <Label text="❤️" styleClass="header-icon"/>
                </StackPane>
                <Label text="Mes Offres Favorites" styleClass="header-title"/>
                <Label fx:id="lblCount" text="0 favori" styleClass="header-subtitle"/>
            </VBox>

            <!-- Barre de navigation et compteur -->
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-max-width: 1200px;">
                <Button fx:id="btnBack" onAction="#goBackToOffresList" styleClass="btn-back-arrow-inline">
                    <graphic>
                        <Label text="←" style="-fx-font-size: 20; -fx-text-fill: #7c3aed;"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Grille des cartes -->
            <FlowPane fx:id="flowFavorites"
                      hgap="24" vgap="24"
                      alignment="CENTER"
                      prefWrapLength="1200"
                      style="-fx-padding: 10;"/>
        </VBox>
    </StackPane>
</ScrollPane>