<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.guser.controllers.getude.MainShellController"
            stylesheets="@css/ThemeUnified.css"
            styleClass="shell-root">

    <!-- Left Sidebar -->
    <left>
        <VBox fx:id="sidebar"
              styleClass="sidebar-animated"
              prefWidth="70" minWidth="70" maxWidth="70"
              onMouseEntered="#expandSidebar"
              onMouseExited="#collapseSidebar">

            <!-- Brand -->
            <VBox styleClass="brand-container" alignment="CENTER">
                <StackPane styleClass="brand-icon">

<ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
    <Image url="@../images/logo.png" />
</ImageView>



                </StackPane>
                <Label fx:id="brandText" text="Carrieri" styleClass="brand-text"/>
                <Label fx:id="brandSubtext" text="Gestion des Etudes" styleClass="brand-subtext"/>
            </VBox>

            <!-- Navigation -->
            <VBox styleClass="nav-container" alignment="CENTER">
                <Button fx:id="btnCours" onAction="#showCoursView" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📚" styleClass="nav-icon"/>
                            <Label fx:id="coursText" text="Cours" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnModules" onAction="#showModulesView" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📦" styleClass="nav-icon"/>
                            <Label fx:id="modulesText" text="Modules" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnLecons" onAction="#showLeconsView" styleClass="nav-button">
                    <graphic>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <Label text="📖" styleClass="nav-icon"/>
                            <Label fx:id="leconsText" text="Leçons" styleClass="nav-text"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- BOUTON DE THÈME - NOUVEAU -->
            <!-- Remplacer votre ancien bouton par celui-ci -->
            <Button fx:id="btnTheme" styleClass="theme-toggle" text="🌙"/>

            <!-- User section -->
            <VBox styleClass="user-container" alignment="CENTER">
                <StackPane>
                    <Circle fx:id="userAvatar" radius="20" styleClass="user-avatar-glow"
                            onMouseClicked="#switchToCandidat"/>
                </StackPane>
                <Label fx:id="userName" text="Admin User" styleClass="user-name"/>
                <Label fx:id="userRole" text="Administrateur" styleClass="user-role"/>
                <Button text="🚪" onAction="#logout" styleClass="logout-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Content Area -->
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>