<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainController"
            prefHeight="600"
            prefWidth="900">

    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER_LEFT" prefHeight="60">
            <Label text="Carrieri - Gestion des Réclamations &amp; Feedback"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Déconnexion"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    onAction="#handleLogout"/>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #34495e; -fx-padding: 20; -fx-spacing: 10;"
              prefWidth="200"
              prefHeight="600">

            <Label text="Menu Principal"
                   style="-fx-text-fill: #ecf0f1; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
            <Separator style="-fx-background-color: #7f8c8d;"/>

            <Button text="📋 Réclamations"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 10; -fx-cursor: hand;"
                    onAction="#showReclamations"/>

            <Button text="⭐ Feedback"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 10; -fx-cursor: hand;"
                    onAction="#showFeedback"/>

            <Button text="🛠️ Traitements"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: center-left; -fx-padding: 10; -fx-cursor: hand;"
                    onAction="#showTraitements"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-background-color: #7f8c8d;"/>
            <Label text="Admin Panel"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 12px; -fx-padding: 5 0 0 0;"/>
            <Label text="© 2026 Carrieri"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #ecf0f1;"/>
    </center>

</BorderPane>