<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MainController"
            prefHeight="600" prefWidth="900">

    <top>
        <VBox>
            <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" alignment="CENTER_LEFT" prefHeight="60">
                <Label text="Gestion des Réclamations &amp; Feedback"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <MenuBar>
                <Menu text="📋 Réclamations">
                    <MenuItem text="Liste des réclamations" onAction="#showReclamationList"/>
                    <MenuItem text="➕ Nouvelle réclamation" onAction="#showReclamationForm"/>
                </Menu>
                <Menu text="⭐ Feedbacks">
                    <MenuItem text="Liste des feedbacks" onAction="#showFeedbackList"/>
                    <MenuItem text="➕ Nouveau feedback" onAction="#showFeedbackForm"/>
                </Menu>
                <Menu text="🛠️ Traitements">
                    <MenuItem text="Liste des traitements" onAction="#showTraitementList"/>
                </Menu>
            </MenuBar>

            <ToolBar>
                <Button text="📋 Réclamations" onAction="#showReclamationList"/>
                <Button text="➕ Nouvelle" onAction="#showReclamationForm"/>
                <Separator orientation="VERTICAL"/>
                <Button text="⭐ Feedbacks" onAction="#showFeedbackList"/>
                <Button text="➕ Nouveau" onAction="#showFeedbackForm"/>
                <Separator orientation="VERTICAL"/>
                <Button text="🛠️ Traitements" onAction="#showTraitementList"/>
                <!-- ✅ Bouton refresh supprimé -->
            </ToolBar>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
            <fx:include source="reclamationList.fxml"/>
        </StackPane>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #bdc3c7; -fx-padding: 5;" alignment="CENTER">
            <Label text="© 2026 - Application de gestion"
                   style="-fx-text-fill: #2c3e50; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Version 1.0"
                   style="-fx-text-fill: #2c3e50; -fx-font-size: 11px; -fx-padding: 0 10 0 0;"/>
        </HBox>
    </bottom>
</BorderPane>