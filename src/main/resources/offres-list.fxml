<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true" fitToHeight="false"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane-clean"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.OffresListController">

    <VBox alignment="TOP_CENTER" spacing="0" styleClass="view-root">

        <!-- ==================== HEADER ==================== -->
        <VBox alignment="CENTER" spacing="16" styleClass="header-gradient" prefHeight="260">
            <padding><Insets top="70" bottom="50"/></padding>

            <StackPane prefWidth="110" prefHeight="110" styleClass="header-icon-circle">
                <Label text="📋" style="-fx-font-size: 80; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.75), 20, 0, 0, 0);"/>
            </StackPane>

            <Label text="Liste des Offres" styleClass="header-title-big"/>
            <Label text="Consultez et Postulez aux offres disponibles"
                   styleClass="header-subtitle" wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <!-- ==================== SEARCH + FILTER + STATUS ==================== -->
        <VBox spacing="28" style="-fx-padding: 40 80 30 80; -fx-background-color: #faf7ff;">

            <HBox spacing="20" alignment="CENTER_LEFT">
                <TextField fx:id="txtSearch" promptText="Rechercher par titre, entreprise, localisation, compétences, secteur..."
                           styleClass="search-input" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnFilter" text="Filtrer" onAction="#toggleFilterPanel" styleClass="btn-filter">
                    <graphic>
                        <Label text="▼" style="-fx-font-size: 13; -fx-text-fill: #7c3aed;"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- ==================== FILTER PANEL (COLLAPSIBLE) ==================== -->
            <VBox fx:id="filterPanel" spacing="20" styleClass="filter-panel"
                  style="-fx-background-color: white; -fx-padding: 24; -fx-background-radius: 16; -fx-border-color: #e0d4f5; -fx-border-radius: 16; -fx-border-width: 2;">

                <Label text="🔍 Filtres avancés" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e1133;"/>

                <GridPane hgap="20" vgap="16">
                    <!-- Type de contrat -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Type de contrat" styleClass="field-label"/>
                        <ComboBox fx:id="comboFilterTypeContrat" maxWidth="Infinity" styleClass="field-combo" prefWidth="250"/>
                    </VBox>

                    <!-- Niveau de qualification -->
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Niveau de qualification" styleClass="field-label"/>
                        <ComboBox fx:id="comboFilterNiveau" maxWidth="Infinity" styleClass="field-combo" prefWidth="250"/>
                    </VBox>

                    <!-- Salaire minimum -->
                    <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Salaire minimum (DT)" styleClass="field-label"/>
                        <TextField fx:id="txtFilterSalaireMin" promptText="Ex: 1500" styleClass="field-input"/>
                    </VBox>

                    <!-- Salaire maximum -->
                    <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Salaire maximum (DT)" styleClass="field-label"/>
                        <TextField fx:id="txtFilterSalaireMax" promptText="Ex: 5000" styleClass="field-input"/>
                    </VBox>
                </GridPane>

                <!-- Boutons d'action -->
                <HBox spacing="16" alignment="CENTER_RIGHT">
                    <Button fx:id="btnResetFilters" text="Réinitialiser" onAction="#handleResetFilters" styleClass="btn-secondary" prefWidth="150"/>
                    <Button fx:id="btnApplyFilters" text="Appliquer" onAction="#handleApplyFilters" styleClass="btn-primary" prefWidth="150"/>
                </HBox>
            </VBox>

            <Label fx:id="lblStatus" text="0 offres trouvées" styleClass="status-label"/>
        </VBox>

        <!-- ==================== CARDS CONTAINER (centered) ==================== -->
        <FlowPane fx:id="flowOffers" hgap="32" vgap="32"
                  alignment="CENTER"
                  style="-fx-padding: 0 80 80 80; -fx-background-color: #faf7ff;">
            <!-- Cards added dynamically -->
        </FlowPane>

    </VBox>
</ScrollPane>